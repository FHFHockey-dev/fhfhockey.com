[Unit]
Description=FHFH X intake fallback (twscrape, layer 3)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Replace pi and the path if the checkout lives elsewhere (README step 4).
User=pi
WorkingDirectory=/home/pi/x-twscrape-fallback
ExecStart=/home/pi/x-twscrape-fallback/.venv/bin/python fallback.py
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true

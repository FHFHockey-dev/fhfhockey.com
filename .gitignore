/node_modules
/.pnpm-store/
/.npm-cache/
/.pnp
.pnp.*js

# testing
/coverage

# next.js
.next
.next-*
/web/next-env.d.ts

# production
/build
dist

# misc
.DS_Store
*.pem
__pycache__/
*.py[cod]
web/tasks/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/.tmp-next-dev.log
/yahoo_historical.log
/web/lib/supabase/sosStandings.log
/web/tmp/team-underlying-audit*.json

# local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.mcp

# Never track Yahoo OAuth token exports; runtime credentials belong in env/Vault-backed storage.
web/lib/supabase/Upserts/yahooAuth/token.json

# Supabase CLI link state is local metadata.
/supabase/.temp/project-ref
/web/supabase/.temp/

# vercel
.vercel

# turbo
.turbo

.swc

# typescript
*.tsbuildinfo

# wsl
*:Zone.Identifier

# Sitemap file
sitemap.xml
sitemap-0.xml

# Robots.txt
robots.txt
*storybook.log

# MCP json
.mcp.json

# Raw local verification output; retain source, fixtures, receipts and PRDs.
/tasks/artifacts/**/*.log
/tasks/artifacts/**/*.tap
/tasks/artifacts/**/*.stdout
/tasks/artifacts/**/*.stderr
/tasks/artifacts/**/test-results/


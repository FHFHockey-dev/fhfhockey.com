{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "ignoreCommand": "test -n \"$VERCEL_GIT_PREVIOUS_SHA\" && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD ./",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 240,
      "memory": 1024
    }
  },
  "routes": [
    { "src": "/sko/pipeline", "dest": "/api/sko/pipeline/index.py" },
    { "src": "/api/(.*)", "dest": "/api/$1" }
  ]
}

+import { describe, expect, it, vi } from "vitest";
+import type { GetServerSidePropsContext } from "next";
+import { getServerSideProps } from "../../../pages/social-share/player-cards";
+
+describe("player-cards page server props", () => {
+  it("keeps headers and adds only a serializable incomplete evidence verdict", async () => {
+    const setHeader = vi.fn();
+    const result = await getServerSideProps({ res: { setHeader } } as unknown as GetServerSidePropsContext);
+    expect(setHeader).toHaveBeenCalledWith("X-Robots-Tag", "noindex, nofollow");
+    expect(result).toMatchObject({ props: { evidence: { state: "incomplete", bundleId: "studio-preview", liveActivation: false, premiumActivation: false } } });
+    expect(JSON.parse(JSON.stringify(result))).toEqual(result);
+  });
+});

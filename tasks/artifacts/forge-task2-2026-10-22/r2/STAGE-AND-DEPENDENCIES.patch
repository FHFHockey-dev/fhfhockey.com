+// ---------------------------------------------------------------------------
+// Count distributions: negative binomial with Poisson fallback (tasks 8.1/8.2).
+// alpha is the NB2 dispersion (Var = mu + alpha * mu^2); alpha null/0 = Poisson.
+// Fitted alphas come from ./dispersion (resolveDispersionAlpha).
+// ---------------------------------------------------------------------------
+
+const NB_MIN_ALPHA = 1e-9;
+
+/**
+ * Opt-in count model for buildPlayerUncertainty / buildGoalieUncertainty.
+ * Default (omitted) keeps the legacy Poisson draws.
+ */
+export type CountModelOptions = {
+  /** Draw SOG/hits/blocks (skaters) or shots against (goalies) from the fitted NB. */
+  negativeBinomial?: boolean;
+  /** F/C/L/R/D/G; unknown positions fall back to Poisson. */
+  position?: string | null;
+};
+
+/**
+ * Per-game alpha inside the simulation, where TOI is already drawn with CV
+ * `simToiCv`: the TOI-conditional fit compounded with whatever empirical TOI
+ * variance (fit.toiCv2) the simulated TOI noise does not cover.
+ */
+function simulationAlpha(
+  stat: DispersionStat,
+  position: string | null | undefined,
+  perGameMean: number,
+  simToiCv: number
+): number | null {
+  const fit = getDispersionFit(stat, position);
+  if (!fit) return null;
+  const residualCv = Math.sqrt(Math.max(0, fit.toiCv2 - simToiCv * simToiCv));
+  return resolveDispersionAlpha(stat, position, perGameMean, { toiCv: residualCv });
+}
+const COUNT_TAIL_EPS = 1e-12;
+const COUNT_MAX_SUPPORT = 20000;
+
+function normalizeAlpha(alpha: number | null | undefined): number {
+  if (alpha == null || !Number.isFinite(alpha) || alpha < NB_MIN_ALPHA) return 0;
+  return alpha;
+}
+
+/** Probability mass over 0..K, truncated once the remaining tail is below 1e-12. */
+export function countPmf(mean: number, alpha?: number | null): number[] {
+  const mu = clampNonNegative(mean);
+  if (mu === 0) return [1];
+  const a = normalizeAlpha(alpha);
+  const r = a > 0 ? 1 / a : Infinity;
+  // log P(0) and the log ratio P(k+1)/P(k).
+  let logP = a > 0 ? -r * Math.log1p(mu / r) : -mu;
+  const logQ = a > 0 ? Math.log(mu / (r + mu)) : Math.log(mu);
+  const pmf: number[] = [];
+  let cumulative = 0;
+  for (let k = 0; k < COUNT_MAX_SUPPORT; k += 1) {
+    const p = Math.exp(logP);
+    pmf.push(p);
+    cumulative += p;
+    if (k >= mu && 1 - cumulative < COUNT_TAIL_EPS) break;
+    logP += a > 0 ? Math.log((k + r) / (k + 1)) + logQ : logQ - Math.log(k + 1);
+  }
+  return pmf;
+}
+
+export function countVariance(mean: number, alpha?: number | null): number {
+  const mu = clampNonNegative(mean);
+  return mu + normalizeAlpha(alpha) * mu * mu;
+}
+
+/** P(X <= k). */
+export function countCdf(k: number, mean: number, alpha?: number | null): number {
+  if (!Number.isFinite(k) || k < 0) return 0;
+  const pmf = countPmf(mean, alpha);
+  const upper = Math.min(Math.floor(k), pmf.length - 1);
+  let total = 0;
+  for (let i = 0; i <= upper; i += 1) total += pmf[i];
+  return Math.min(1, total);
+}
+
+/** P(X >= k). */
+export function countProbabilityAtLeast(
+  k: number,
+  mean: number,
+  alpha?: number | null
+): number {
+  if (!Number.isFinite(k) || k <= 0) return 1;
+  return Math.max(0, 1 - countCdf(Math.ceil(k) - 1, mean, alpha));
+}
+
+/** Smallest integer k with P(X <= k) >= p. */
+export function countQuantile(p: number, mean: number, alpha?: number | null): number {
+  const pmf = countPmf(mean, alpha);
+  const target = Math.max(0, Math.min(1, p));
+  let total = 0;
+  for (let k = 0; k < pmf.length; k += 1) {
+    total += pmf[k];
+    if (total >= target - 1e-12) return k;
+  }
+  return pmf.length - 1;
+}
+
+export type CountDistributionSummary = {
+  mean: number;
+  /** NB dispersion used; 0 means Poisson. */
+  alpha: number;
+  model: "negative_binomial" | "poisson";
+  variance: number;
+  /** P(X >= k) keyed by k. */
+  pAtLeast: Record<number, number>;
+  quantiles: { p10: number; p50: number; p90: number };
+};
+
+export function summarizeCountDistribution(
+  mean: number,
+  alpha?: number | null,
+  atLeast: number[] = [1, 2, 3, 4, 5]
+): CountDistributionSummary {
+  const mu = clampNonNegative(mean);
+  const a = normalizeAlpha(alpha);
+  const pmf = countPmf(mu, a);
+  const cdf: number[] = [];
+  pmf.reduce((acc, p, k) => (cdf[k] = acc + p), 0);
+  const cdfAt = (k: number) => (k < 0 ? 0 : Math.min(1, cdf[Math.min(k, cdf.length - 1)]));
+  const quantileAt = (p: number) => {
+    const k = cdf.findIndex((c) => c >= p - 1e-12);
+    return k < 0 ? cdf.length - 1 : k;
+  };
+  const pAtLeast: Record<number, number> = {};
+  for (const k of atLeast) {
+    if (!Number.isFinite(k)) continue;
+    const kk = Math.max(0, Math.ceil(k));
+    pAtLeast[kk] = round6(kk === 0 ? 1 : Math.max(0, 1 - cdfAt(kk - 1)));
+  }
+  return {
+    mean: round3(mu),
+    alpha: round6(a),
+    model: a > 0 ? "negative_binomial" : "poisson",
+    variance: round3(countVariance(mu, a)),
+    pAtLeast,
+    quantiles: { p10: quantileAt(0.1), p50: quantileAt(0.5), p90: quantileAt(0.9) }
+  };
+}
+
+function round6(n: number): number {
+  return Number(n.toFixed(6));
+}
+
+export type StatDistributionOptions = ResolveDispersionOptions & {
+  /** Overrides the fitted alpha (null forces Poisson). */
+  alphaOverride?: number | null;
+  atLeast?: number[];
+};
+
+function statAlpha(
+  stat: DispersionStat,
+  position: string | null | undefined,
+  mean: number,
+  options: StatDistributionOptions
+): number | null {
+  if (options.alphaOverride !== undefined) return options.alphaOverride;
+  return resolveDispersionAlpha(stat, position, mean, options);
+}
+
+/** Mean, P(X >= k) and quantiles for a projected stat total; Poisson when no alpha is fitted. */
+export function summarizeStatDistribution(
+  stat: DispersionStat,
+  position: string | null | undefined,
+  mean: number,
+  options: StatDistributionOptions = {}
+): CountDistributionSummary {
+  return summarizeCountDistribution(
+    mean,
+    statAlpha(stat, position, mean, options),
+    options.atLeast
+  );
+}
+
+export type OverUnderPush = { over: number; under: number; push: number };
+
+/** Over = X > line, under = X < line, push = X == line (integer lines only). */
+export function overUnderPushProbabilities(
+  mean: number,
+  alpha: number | null | undefined,
+  line: number
+): OverUnderPush {
+  if (!Number.isFinite(line)) return { over: 0, under: 0, push: 0 };
+  if (line < 0) return { over: 1, under: 0, push: 0 };
+  const pmf = countPmf(mean, alpha);
+  const pAt = (k: number) => (k >= 0 && k < pmf.length ? pmf[k] : 0);
+  let cdfFloor = 0;
+  for (let k = 0; k <= Math.min(Math.floor(line), pmf.length - 1); k += 1) cdfFloor += pmf[k];
+  cdfFloor = Math.min(1, cdfFloor);
+  const isInteger = Math.abs(line - Math.round(line)) < 1e-9;
+  const push = isInteger ? pAt(Math.round(line)) : 0;
+  return {
+    over: Math.max(0, 1 - cdfFloor),
+    under: Math.max(0, cdfFloor - push),
+    push
+  };
+}
+
+/**
+ * P(over `line`) for a projected stat total, e.g. P(SOG > 2.5). Integer lines
+ * exclude the push (X == line); divide by (over + under) for a no-push price.
+ * Falls back to Poisson when no dispersion is fitted for (stat, position).
+ */
+export function probabilityOverLine(
+  stat: DispersionStat,
+  position: string | null | undefined,
+  mean: number,
+  line: number,
+  options: StatDistributionOptions = {}
+): number {
+  return overUnderPushProbabilities(mean, statAlpha(stat, position, mean, options), line).over;
+}
+
+/** Per-game TOI CV implied by the ES/PP TOI noise used in buildPlayerUncertainty. */
+export function playerToiCv(
+  toiEsSeconds: number,
+  toiPpSeconds: number,
+  esSdPct: number = UNCERTAINTY_CONFIG.playerEsToiSdPct,
+  ppSdPct: number = UNCERTAINTY_CONFIG.playerPpToiSdPct
+): number {
+  const es = clampNonNegative(toiEsSeconds);
+  const pp = clampNonNegative(toiPpSeconds);
+  const total = es + pp;
+  if (total <= 0) return 0;
+  return Math.sqrt((es * esSdPct) ** 2 + (pp * ppSdPct) ** 2) / total;
+}
+
+/** Gamma(shape, scale = 1/shape) multiplier with mean 1 and variance 1/shape (Marsaglia-Tsang). */
+function sampleGammaMeanOne(shape: number, rand: () => number): number {
+  if (!Number.isFinite(shape) || shape <= 0) return 1;
+  if (shape < 1) {
+    const u = Math.max(rand(), 1e-12);
+    return sampleGammaMeanOne(shape + 1, rand) * ((shape + 1) / shape) * u ** (1 / shape);
+  }
+  const d = shape - 1 / 3;
+  const c = 1 / Math.sqrt(9 * d);
+  for (let i = 0; i < 100; i += 1) {
+    const x = sampleNormal(0, 1, rand);
+    const v = (1 + c * x) ** 3;
+    if (v <= 0) continue;
+    const u = Math.max(rand(), 1e-12);
+    if (Math.log(u) < 0.5 * x * x + d - d * v + d * Math.log(v)) return (d * v) / shape;
+  }
+  return 1;
+}
+
+/** Gamma-Poisson draw: X ~ NB(mean, alpha); alpha 0/null draws Poisson. */
+export function sampleNegativeBinomial(
+  mean: number,
+  alpha: number | null | undefined,
+  rand: () => number
+): number {
+  const a = normalizeAlpha(alpha);
+  if (a === 0) return samplePoisson(mean, rand);
+  return samplePoisson(clampNonNegative(mean) * sampleGammaMeanOne(1 / a, rand), rand);
+}
diff --git a/web/lib/projections/utils/devig.ts b/web/lib/projections/utils/devig.ts
new file mode 100644
index 000000000..609391924
--- /dev/null
+++ b/web/lib/projections/utils/devig.ts
@@ -0,0 +1,224 @@
+/**
+ * Sportsbook price helpers: convert American odds to implied probabilities and
+ * remove the bookmaker margin ("de-vig") so model probabilities can be compared
+ * with market probabilities in probability space.
+ *
+ * Methods:
+ * - "shin" (default): Shin (1993) insider-trading model. Solves for the insider
+ *   share z so the fair probabilities sum to 1. For two-way markets Shin is
+ *   mathematically identical to the additive / equal-margin method; it differs
+ *   (and shades longshots harder than proportional) for three or more outcomes.
+ * - "proportional": divide each implied probability by the overround. Known to
+ *   overstate longshots.
+ * - "equal-margin": subtract an equal share of the overround from each outcome.
+ *
+ * "Yes"-only markets (e.g. anytime goal scorer) have no opposing price, so the
+ * overround cannot be observed. `devigYesOnly` assumes a total two-way
+ * overround (DEFAULT_YES_ONLY_OVERROUND, configurable) and applies the
+ * equal-margin rule: fair = implied - overround / 2.
+ */
+
+export type DevigMethod = "shin" | "proportional" | "equal-margin";
+
+/**
+ * Assumed total overround for "Yes"-only markets. Major props carry about
+ * 4-6% and secondary props 6-10% (Wizard of Odds, cited in the deep-research
+ * report); anytime goal scorer is a secondary market, so 8% is the midpoint
+ * assumption until it is calibrated against two-way goal markets.
+ */
+export const DEFAULT_YES_ONLY_OVERROUND = 0.08;
+
+/** Two-way books whose implied probabilities sum outside this band are rejected as bad data. */
+export const MIN_VALID_BOOK_SUM = 0.98;
+export const MAX_VALID_BOOK_SUM = 1.35;
+
+/**
+ * American odds are invalid in (-100, 100). Some stored rows hold decimal odds
+ * (e.g. 1, 2) in price_american; those return null rather than a bogus price.
+ */
+export function isValidAmericanPrice(price: number | null | undefined): price is number {
+  return (
+    typeof price === "number" &&
+    Number.isFinite(price) &&
+    (price >= 100 || price <= -100)
+  );
+}
+
+export function americanToDecimal(price: number | null | undefined): number | null {
+  if (!isValidAmericanPrice(price)) return null;
+  return price > 0 ? 1 + price / 100 : 1 + 100 / -price;
+}
+
+export function americanToImpliedProbability(
+  price: number | null | undefined,
+): number | null {
+  const decimal = americanToDecimal(price);
+  return decimal == null ? null : 1 / decimal;
+}
+
+function isProbability(value: number): boolean {
+  return Number.isFinite(value) && value > 0 && value < 1;
+}
+
+export type DevigResult = {
+  probabilities: number[];
+  /** Sum of the raw implied probabilities minus 1 (the book margin). */
+  overround: number;
+  method: DevigMethod;
+  /** Shin insider share; only set for method "shin". */
+  shinZ?: number;
+};
+
+function shinProbability(pi: number, total: number, z: number): number {
+  return (Math.sqrt(z * z + (4 * (1 - z) * pi * pi) / total) - z) / (2 * (1 - z));
+}
+
+export function devigShin(implied: number[]): DevigResult | null {
+  if (implied.length < 2 || !implied.every(isProbability)) return null;
+  const total = implied.reduce((sum, p) => sum + p, 0);
+  const overround = total - 1;
+  if (overround <= 0) {
+    // No margin (or an arbitrage): Shin has no positive insider share; normalise.
+    return {
+      probabilities: implied.map((p) => p / total),
+      overround,
+      method: "shin",
+      shinZ: 0,
+    };
+  }
+  // Sum of Shin probabilities decreases monotonically in z; bisection on [0, 1).
+  const sumAt = (z: number) =>
+    implied.reduce((sum, p) => sum + shinProbability(p, total, z), 0);
+  let lo = 0;
+  let hi = 0.999;
+  for (let i = 0; i < 100; i += 1) {
+    const mid = (lo + hi) / 2;
+    if (sumAt(mid) > 1) lo = mid;
+    else hi = mid;
+  }
+  const z = (lo + hi) / 2;
+  const raw = implied.map((p) => shinProbability(p, total, z));
+  const rawSum = raw.reduce((sum, p) => sum + p, 0);
+  return {
+    probabilities: raw.map((p) => p / rawSum),
+    overround,
+    method: "shin",
+    shinZ: z,
+  };
+}
+
+export function devigProportional(implied: number[]): DevigResult | null {
+  if (implied.length < 2 || !implied.every(isProbability)) return null;
+  const total = implied.reduce((sum, p) => sum + p, 0);
+  return {
+    probabilities: implied.map((p) => p / total),
+    overround: total - 1,
+    method: "proportional",
+  };
+}
+
+export function devigEqualMargin(implied: number[]): DevigResult | null {
+  if (implied.length < 2 || !implied.every(isProbability)) return null;
+  const total = implied.reduce((sum, p) => sum + p, 0);
+  const share = (total - 1) / implied.length;
+  const shifted = implied.map((p) => p - share);
+  // A heavy longshot can go non-positive under additive removal; fall back to proportional.
+  if (!shifted.every((p) => p > 0)) return devigProportional(implied);
+  return {
+    probabilities: shifted,
+    overround: total - 1,
+    method: "equal-margin",
+  };
+}
+
+export function devig(
+  implied: number[],
+  method: DevigMethod = "shin",
+): DevigResult | null {
+  switch (method) {
+    case "proportional":
+      return devigProportional(implied);
+    case "equal-margin":
+      return devigEqualMargin(implied);
+    case "shin":
+    default:
+      return devigShin(implied);
+  }
+}
+
+/**
+ * De-vig a two-way market from its two American prices. Returns null when a
+ * price is invalid or the book sum is outside [MIN_VALID_BOOK_SUM, MAX_VALID_BOOK_SUM].
+ */
+export function devigTwoWayAmerican(
+  priceA: number | null | undefined,
+  priceB: number | null | undefined,
+  method: DevigMethod = "shin",
+): (DevigResult & { fairA: number; fairB: number }) | null {
+  const a = americanToImpliedProbability(priceA);
+  const b = americanToImpliedProbability(priceB);
+  if (a == null || b == null) return null;
+  const total = a + b;
+  if (total < MIN_VALID_BOOK_SUM || total > MAX_VALID_BOOK_SUM) return null;
+  const result = devig([a, b], method);
+  if (!result) return null;
+  return {
+    ...result,
+    fairA: result.probabilities[0],
+    fairB: result.probabilities[1],
+  };
+}
+
+/**
+ * Fair probability for a "Yes"-only price under an assumed total overround.
+ * "equal-margin" (default): implied - overround / 2, i.e. the price an additive
+ * (= two-way Shin) de-vig would give if the hidden "No" side carried the other
+ * half of the margin. "proportional": implied / (1 + overround). Equal-margin
+ * results at or below zero (extreme longshots) fall back to proportional.
+ */
+export function devigYesOnly(
+  price: number | null | undefined,
+  options: {
+    overround?: number;
+    method?: "equal-margin" | "proportional";
+  } = {},
+): { probability: number; implied: number; overround: number; method: "equal-margin" | "proportional" } | null {
+  const implied = americanToImpliedProbability(price);
+  if (implied == null) return null;
+  const overround = options.overround ?? DEFAULT_YES_ONLY_OVERROUND;
+  if (!Number.isFinite(overround) || overround < 0) return null;
+  const proportional = implied / (1 + overround);
+  if (options.method === "proportional") {
+    return { probability: proportional, implied, overround, method: "proportional" };
+  }
+  const equalMargin = implied - overround / 2;
+  if (equalMargin <= 0) {
+    return { probability: proportional, implied, overround, method: "proportional" };
+  }
+  return { probability: equalMargin, implied, overround, method: "equal-margin" };
+}
+
+/** Expected profit per 1 unit staked at an American price, given a win probability. */
+export function expectedValueAtAmericanPrice(
+  probability: number,
+  price: number | null | undefined,
+): number | null {
+  const decimal = americanToDecimal(price);
+  if (decimal == null || !Number.isFinite(probability)) return null;
+  return probability * decimal - 1;
+}
+
+export function median(values: number[]): number | null {
+  const finite = values.filter((v) => Number.isFinite(v)).sort((a, b) => a - b);
+  if (finite.length === 0) return null;
+  const mid = Math.floor(finite.length / 2);
+  return finite.length % 2 === 1 ? finite[mid] : (finite[mid - 1] + finite[mid]) / 2;
+}
+
+/** Inverse of americanToImpliedProbability, for prices rebuilt from averaged probabilities. */
+export function impliedProbabilityToAmerican(probability: number): number | null {
+  if (!isProbability(probability)) return null;
+  return probability >= 0.5
+    ? -(100 * probability) / (1 - probability)
+    : (100 * (1 - probability)) / probability;
+}

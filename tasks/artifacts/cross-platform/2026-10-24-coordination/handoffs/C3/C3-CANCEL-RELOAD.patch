 import supabase from "lib/supabase/client";
 
 type Subscription = { subscriptionId: string; cancelledAt: string | null; billingStoppedAt: string | null; stopComplete: boolean };
+type PendingCancellation = { requestId: string; savedAt: number };
 
+// Unresolved cancellation IDs survive a same-tab reload for the same session owner
+// only. Foreign, malformed or stale entries are discarded, never reattached.
+const cancellationStorageKey = "fhfh:in-season-cancellation:v1";
+const cancellationMaxAgeMs = 24 * 60 * 60 * 1000;
+function cancellationStorage() { try { return window.sessionStorage; } catch { return null; } }
+function saveCancellations(ownerId: string | null, pending: Record<string, PendingCancellation>) {
+  try {
+    if (!ownerId || Object.keys(pending).length === 0) cancellationStorage()?.removeItem(cancellationStorageKey);
+    else cancellationStorage()?.setItem(cancellationStorageKey, JSON.stringify({ ownerId, requests: pending }));
+  } catch { /* Mounted in-memory continuity still applies without storage. */ }
+}
+function restoreCancellations(ownerId: string, now = Date.now()) {
+  const pending: Record<string, PendingCancellation> = {};
+  try {
+    const saved: unknown = JSON.parse(cancellationStorage()?.getItem(cancellationStorageKey) ?? "null");
+    const requests = saved && typeof saved === "object" && "ownerId" in saved && saved.ownerId === ownerId && "requests" in saved ? saved.requests : null;
+    for (const [subscriptionId, entry] of Object.entries(requests && typeof requests === "object" ? requests : {})) {
+      const { requestId, savedAt } = (entry ?? {}) as Partial<PendingCancellation>;
+      if (/^sub_[a-zA-Z0-9]{1,150}$/.test(subscriptionId) && typeof requestId === "string" && /^[a-f0-9-]{36}$/.test(requestId)
+        && Number.isSafeInteger(savedAt) && savedAt! <= now && now - savedAt! < cancellationMaxAgeMs) pending[subscriptionId] = { requestId, savedAt: savedAt! };
+    }
+  } catch { /* Corrupt state is dropped below. */ }
+  saveCancellations(ownerId, pending);
+  return pending;
+}

<body>
  <div>
    <section
      aria-labelledby="draft-pro-panel-title"
      class="_panel_355982"
    >
      <div
        class="_heading_355982"
      >
        <div>
          <p
            class="_eyebrow_355982"
          >
            Account access
          </p>
          <h2
            id="draft-pro-panel-title"
          >
            Draft Pro
          </h2>
        </div>
        <span
          class="_inactive_355982"
        >
          Inactive
        </span>
      </div>
      <p
        class="_summary_355982"
      >
        Your retained Draft Pro work is locked while access is inactive.
         No automatic renewal.
      </p>
      <div
        class="_notice_355982"
        role="status"
      >
        <p>
          Payment is confirming with Stripe.
        </p>
        <div
          class="_actions_355982"
        >
          <button
            type="button"
          >
            Check purchase status again
          </button>
        </div>
      </div>
      <p
        class="_notice_355982"
      >
        New Draft Pro purchases are closed. Existing access, saved work and purchase recovery remain available.
      </p>
      <form
        aria-labelledby="draft-pro-access-code-title"
        class="_accessCodeForm_355982"
      >
        <h3
          id="draft-pro-access-code-title"
        >
          Have an access code?
        </h3>
        <p>
          Enter your purchase recovery code or a complimentary code. Codes work only with the account they belong to.
        </p>
        <label
          for="draft-pro-access-code"
        >
          Draft Pro access code
        </label>
        <div
          class="_accessCodeRow_355982"
        >
          <input
            autocomplete="off"
            id="draft-pro-access-code"
            inputmode="text"
            maxlength="200"
            minlength="20"
            name="code"
            type="text"
            value=""
          />
          <button
            type="submit"
          >
            Redeem code
          </button>
        </div>
      </form>
      <p
        class="_muted_355982"
      >
        <a
          href="/draft-pro/policies#terms"
        >
          Terms
        </a>
         · 
        <a
          href="/draft-pro/policies#privacy"
        >
          Privacy
        </a>
         · 
        <a
          href="/draft-pro/policies#refunds"
        >
          Refund requests
        </a>
         · 
        <a
          href="mailto:tim@fhfhockey.com"
        >
          Support
        </a>
      </p>
      <div>
        <h3>
          Available with Draft Pro
        </h3>
        <p>
          No premium capabilities are currently available. Free manual drafting remains available.
        </p>
        <p
          class="_muted_355982"
        >
          Existing Draft Pro access continues under its original terms.
        </p>
      </div>
      <dl
        class="_details_355982"
      >
        <div>
          <dt>
            Access expires
          </dt>
          <dd>
            Unavailable
             (Eastern)
          </dd>
        </div>
        <div>
          <dt>
            Verified
          </dt>
          <dd>
            Unavailable
          </dd>
        </div>
        <div>
          <dt>
            Patreon status
          </dt>
          <dd>
            Not granting access
          </dd>
        </div>
      </dl>
      <div
        class="_actions_355982"
      >
        <button
          type="button"
        >
          Refresh Patreon
        </button>
        <button
          type="button"
        >
          Connect Patreon
        </button>
      </div>
      <div
        class="_savedItems_355982"
      >
        <h3>
          Saved work
        </h3>
        <div>
          <span>
            Opening night
          </span>
          <span>
            active
          </span>
        </div>
      </div>
      <p>
        For purchases sold through Link, Stripe may issue refunds within 60 days. Our seven-day account form does not limit that policy. 
        <a
          href="https://support.link.com/questions/sold-through-link-refunds"
        >
          Get refund help from Link
        </a>
        .
      </p>
      <p
        role="status"
      >
        Stripe checkout is not configured. STRIPE_SECRET_KEY unset
      </p>
    </section>
  </div>
</body>


+function useTeamLineCombos(teamId: string, enabled: boolean) {
+  const [result, setResult] = useState<LineCombosResult | null>(null);
+  const resultRef = useRef<LineCombosResult | null>(null);
+
+  useEffect(() => {
+    const cached = resultRef.current;

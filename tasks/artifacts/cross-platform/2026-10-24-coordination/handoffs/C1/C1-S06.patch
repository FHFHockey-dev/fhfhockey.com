+function routeTables(tables: Record<string, () => unknown>) {
+  fromMock.mockImplementation((table: string) => {
+    const next = tables[table];
+    if (!next) throw new Error(`Unexpected read: ${table}`);
+    return next();
+  });
+}
+
+async function flush() {
+  await act(async () => {
+    await Promise.resolve();
+    await Promise.resolve();

+export type StreamNight = MatchupGame & { team: ShareTeam; weekRank: number; remainingGames: number; oppDef: number };
+
+/**
+ * Streaming nights: counted games for top-half Week Score teams against a soft defense
+ * (DEF ≤ 33), off-nights first, then the softest opponent, then the better schedule.
+ * One night per team, so the card names eight different streaming teams.
+ */
+export function streamingNights(snapshot: SocialShareSnapshot, trusted: boolean): StreamNight[] {
+  if (!trusted || !opponentsReady(snapshot)) return [];
+  const defense = opponentDefense(snapshot);
+  return snapshot.rows.filter(row => row.remainingGames > 0 && row.rank <= STREAM_TEAM_RANK_MAX)
+    .flatMap(row => countedGames(snapshot, row.team, defense).filter(game => game.oppDef !== null && game.oppDef <= SOFT_DEFENSE_MAX)
+      .map(game => ({ ...game, oppDef: game.oppDef!, team: row.team, weekRank: row.rank, remainingGames: row.remainingGames })))
+    .sort((a, b) => Number(b.offNight) - Number(a.offNight) || a.oppDef - b.oppDef || a.weekRank - b.weekRank || a.date.localeCompare(b.date) || a.id - b.id)
+    .filter((night, index, nights) => nights.findIndex(item => item.team.id === night.team.id) === index)
+    .slice(0, STREAM_LIMIT);
+}

+// Monday best-schedules grid: two 16-team panels of square 44px day cells.
+$grid-padding: 36px;
+$grid-cell: 44px;
+$grid-gap: 4px;
+.gridSquare { padding: $grid-padding; gap: 14px; }
+.gridHeader { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: v.$space-md; height: 96px; }
+.gridBrand { display: grid; gap: v.$space-xxs; justify-items: start;
+  strong { font: 400 40px "Share Train One", sans-serif; color: v.$primary-color; }
+  span { font-size: 18px; letter-spacing: v.$mobile-letter-spacing-wide; color: v.$text-secondary; }
+  img { display: block; }
+}
+.gridTitle { text-align: center;
+  p { font-size: 20px; font-weight: 700; color: v.$color-blue-300; text-transform: uppercase; letter-spacing: v.$mobile-letter-spacing-wide; }
+  h2 { font-size: 60px; line-height: 1; font-weight: 900; color: v.$color-white; letter-spacing: 0.01em; margin-top: v.$space-xxs; }
+}
+.gridWeek { display: grid; justify-items: end; gap: v.$space-xxs;
+  span { font-size: 16px; letter-spacing: v.$mobile-letter-spacing-wide; color: v.$text-secondary; }
+  strong { font: 600 24px "Share Martian Mono", monospace; color: v.$color-white; }
+}
+.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; flex: 1; min-height: 0; }
+.gridPanel { display: grid; grid-auto-rows: $grid-cell; row-gap: $grid-gap; align-content: start; }
+.gridRow { display: grid; grid-template-columns: 30px $grid-cell repeat(7, $grid-cell) 1fr; column-gap: 5px; align-items: center; position: relative; }
+.gridDays { height: 40px; align-self: end;
+  > span { display: grid; justify-items: center; gap: 1px; font-size: 13px; font-weight: 700; color: v.$text-secondary; letter-spacing: 0.04em; }
+  strong { font-size: 16px; color: v.$color-white; }
+  small { font: 500 12px "Share Martian Mono", monospace; }
+  .offNightDay { background: rgba(v.$success-color, 0.16); border-radius: 6px 6px 0 0; height: 40px; align-content: center;
+    strong, small { color: v.$success-color; }
+  }
+}
+.topRow::before { content: ""; position: absolute; inset: 4px auto 4px -10px; width: 4px; border-radius: 2px; background: v.$primary-color; }
+.gridRank { font: 600 18px "Share Martian Mono", monospace; color: v.$color-blue-300; text-align: right; padding-right: 2px; }
+.gridTeam { display: grid; place-items: center; width: $grid-cell; height: $grid-cell; img { display: block; } }
+.cell { position: relative; display: grid; place-items: center; width: $grid-cell; height: $grid-cell; border-radius: 6px; border: 2px solid transparent;
+  img { display: block; }
+}
+.offNightColumn { background: rgba(v.$success-color, 0.06); }
+.homeCell { background: rgba(v.$color-white, 0.12); }
+.awayCell { border-color: rgba(v.$color-white, 0.16); }
+.offNightGame { border-color: v.$success-color; }
+.dimmed { opacity: 0.35; }
+.awayMark, .doubleMark { position: absolute; font-style: normal; font-weight: 800; line-height: 1; border-radius: 3px; background: v.$background-dark; }
+.awayMark { top: -3px; left: -3px; font-size: 13px; padding: 1px 2px; color: v.$color-blue-300; }
+.doubleMark { bottom: -3px; right: -3px; font-size: 11px; padding: 1px 2px; color: v.$color-white; }
+.logoFallback { display: grid; place-items: center; width: 100%; height: 100%; font-size: 13px; font-weight: 800; color: v.$color-white; letter-spacing: 0.02em; }
+.gridGames { display: grid; justify-items: center; line-height: 1;
+  strong { font: 600 22px "Share Martian Mono", monospace; color: v.$color-white; }
+  small { font-size: 11px; font-weight: 700; color: v.$success-color; margin-top: 3px; letter-spacing: 0.04em; }
+  .noOff { color: v.$text-secondary; }
+}
+.gridFooter { border-top: 1px solid v.$border-soft; padding-top: v.$space-xs; display: grid; gap: 6px; font-size: 15px; color: v.$text-secondary; line-height: 1.25;
+  p { display: flex; justify-content: space-between; gap: v.$space-md; align-items: baseline; }
+}
+.legend { display: flex; flex-wrap: wrap; gap: v.$space-xs v.$space-lg; color: v.$color-white; font-size: 17px;
+  span { display: inline-flex; align-items: center; gap: 6px; }
+  i { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 4px; font-style: normal; font-weight: 800; font-size: 14px; border: 2px solid transparent; }
+  b { color: v.$color-blue-300; }
+}
+.legendAway { color: v.$color-blue-300; border-color: rgba(v.$color-white, 0.16) !important; }
+.legendHome { background: rgba(v.$color-white, 0.12); }
+.legendOff { border-color: v.$success-color !important; }
+.gridWatermark { flex: none; color: v.$color-blue-300; letter-spacing: v.$mobile-letter-spacing-wide; }
 @media (max-width: v.$breakpoint-tablet) {
   .page { padding: v.$space-xs; }
   .workspace { grid-template-columns: minmax(0, 1fr); }

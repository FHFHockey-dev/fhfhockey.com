+      ? ["shots_against", "saves", "goals_against", "xg_against", "hd_shots_against", "hd_saves"]
+      : Number(row.toi) > 0 ? ["toi_per_gp", "shots_against_per_60", "saves_per_60", "gaa", "xg_against_per_60", "hd_shots_against_per_60", "hd_saves_per_60"] : [];

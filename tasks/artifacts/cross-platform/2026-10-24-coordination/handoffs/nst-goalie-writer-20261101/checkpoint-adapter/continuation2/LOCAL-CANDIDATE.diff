+      gp: 1, toi: 60, shots_against: 20, saves: 19, goals_against: 1, xg_against: 1.1, hd_shots_against: 4, hd_saves: 3,
+      toi_per_gp: 60, shots_against_per_60: 20, saves_per_60: 19, gaa: 1, xg_against_per_60: 1.1,

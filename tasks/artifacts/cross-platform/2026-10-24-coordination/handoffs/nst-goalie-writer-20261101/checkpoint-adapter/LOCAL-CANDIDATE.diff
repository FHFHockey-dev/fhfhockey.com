+  scope: string;
+  /** Fetch/parse/map only; this callback must never write output/checkpoints. */
+  source: (unit: GoalieWorkUnit, control: NstRequestControl, signal: AbortSignal) => Promise<GoalieSourceResult>;
+  deadlineAt: number;
+  now?: () => number;

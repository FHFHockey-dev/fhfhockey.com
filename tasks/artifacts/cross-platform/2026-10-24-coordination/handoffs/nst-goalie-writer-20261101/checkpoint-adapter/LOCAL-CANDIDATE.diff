+      when 'allCounts' then 'nst_gamelog_goalie_all_counts' when 'allRates' then 'nst_gamelog_goalie_all_rates'
+      when 'ppCounts' then 'nst_gamelog_goalie_pp_counts' when 'ppRates' then 'nst_gamelog_goalie_pp_rates'

+describe('one retained source event and the snapshot built from it', () => {
+  const text = 'Levi starts in net vs the Oilers tonight.';
+  const event = (id: string, extra: any = {}) => ({id,source:'tweet',source_group:'gameday',source_key:'gamedaynewsnhl',source_account:'GameDayNewsNHL',username:'GameDayNewsNHL',
+    text,link_to_tweet:null,tweet_id:null,tweet_created_at:null,created_at_label:null,processing_status:'processed',received_at:'2026-10-22T16:57:27.000Z',raw_payload:{},...extra});
+  const snapshot = (eventId: string | null, extra: any = {}) => ({...baseRow,capture_key:`2026-10-22:22:no-game:no-wrapper-tweet:no-quoted-tweet:goalie_start:accepted:${eventId}`,
+    source_group:'gameday',source_key:'gamedaynewsnhl',source_account:'GameDayNewsNHL',tweet_id:null,tweet_url:null,source_url:null,raw_text:text,
+    observed_at:'2026-10-22T16:57:27.000Z',metadata:eventId ? {iftttEventId:eventId} : {},...extra});
+  const keys = async (snapshots: any[], events: any[]) => {
+    const f = fakeDb(snapshots,'line_source_snapshots',[],{line_source_ifttt_events:events});
+    await syncTweetPatternReviewItems({supabase:f.db,perSourceLimit:10});
+    return {f,keys:f.writes.map(w => w.dedupe_key)};
+  };
+  it('gives a linkless event and its linkless snapshot one review identity', async () => {
+    const {f,keys:k} = await keys([snapshot('evt-1')],[event('evt-1')]);
+    expect(k).toHaveLength(1);
+    expect(f.writes[0].source_table).toBe('line_source_snapshots');
+    expect(f.selects.line_source_snapshots).toContain('ifttt_event_id:metadata->>iftttEventId');
+  });
+  it('keys a linkless event to the tweet identity its snapshot recovered', async () => {
+    const {keys:k} = await keys([snapshot('evt-2',{tweet_id:'2113311716893463008'})],[event('evt-2')]);
+    expect(k).toEqual(['gamedaynewsnhl:2113311716893463008']);
+  });
+  it('keeps distinct events with identical text as distinct sources (no text matching)', async () => {
+    const {keys:k} = await keys([snapshot('evt-3'),snapshot('evt-4',{capture_key:'other-capture'})],[event('evt-3'),event('evt-4')]);
+    expect(new Set(k).size).toBe(2);
+  });
+  it('does not re-key an event that carries its own different post ID', async () => {
+    const {keys:k} = await keys([snapshot('evt-5',{tweet_id:'111'})],[event('evt-5',{tweet_id:'222'})]);
+    expect([...k].sort()).toEqual(['gamedaynewsnhl:111','gamedaynewsnhl:222']);
+  });
+  it('leaves an event alone when no snapshot names it', async () => {
+    const {keys:k} = await keys([snapshot(null)],[event('evt-6')]);

+// @vitest-environment node
+import { describe, expect, it } from "vitest";
+import { estimatePositionPrior, fitSplitHalfK, type HistoricalCounts, type PriorScope } from "./priors";
+
+const scope: PriorScope = { season: "20262027", before: "2026-10-20T00:00:00Z", position: "F", strength: "ES", metric: "shotsPer60" };
+function row(change: Partial<HistoricalCounts> = {}): HistoricalCounts {
+  return { playerId: 1, gameId: 1, season: scope.season, position: "F", strength: "ES", playedAt: "2026-10-10T00:00:00Z",
+    availableAt: "2026-10-11T00:00:00Z", toiSeconds: 1200, shots: 4, goals: 1, assists: 1, onIceGoals: 2, ...change };
+}
+
+describe("position-specific historical priors", () => {
+  it("pools counts over exposure rather than averaging per-game rates", () => {
+    const result = estimatePositionPrior([row(), row({ gameId: 2, shots: 2, toiSeconds: 600 })], scope);
+    expect(result).toMatchObject({ events: 6, exposure: 0.5, mean: 12, unit: "hours", rows: 2 });
+    expect(estimatePositionPrior([row()], { ...scope, metric: "goalsPerShot" })).toMatchObject({ mean: 0.25, exposure: 4, unit: "shots" });
+    expect(estimatePositionPrior([row()], { ...scope, metric: "assistsPerOnIceGoal" })).toMatchObject({ mean: 0.5, unit: "onIceGoals" });
+    expect(estimatePositionPrior([row()], { ...scope, metric: "pointsPerOnIceGoal" })).toMatchObject({ mean: 1, unit: "onIceGoals" });
+  });
+
+  it("does not mix positions, strengths, seasons or future availability", () => {
+    const rows = [row(), row({ position: "D" }), row({ strength: "PP" }), row({ season: "20252026" }),
+      row({ gameId: 2, availableAt: scope.before }), row({ gameId: 3, playedAt: scope.before, availableAt: scope.before }), row({ gameId: 4, toiSeconds: null })];
+    expect(estimatePositionPrior(rows, scope)).toMatchObject({ rows: 1, mean: 12, excluded: { outsideScope: 3, notAvailableBeforeCutoff: 2, missingExposure: 1 } });
+  });
+
+  it("blocks malformed frames and duplicates without manufacturing priors", () => {
+    expect(estimatePositionPrior([row({ shots: null })], scope).mean).toBeNull();
+    expect(() => estimatePositionPrior([row(), row()], scope)).toThrow("Duplicate");
+    expect(() => estimatePositionPrior([row({ shots: 0, goals: 1 })], { ...scope, metric: "goalsPerShot" })).toThrow();
+    expect(() => estimatePositionPrior([row({ goals: 2, assists: 1, onIceGoals: 2 })], { ...scope, metric: "pointsPerOnIceGoal" })).toThrow();
+    expect(() => estimatePositionPrior([row({ availableAt: "2026-10-09T00:00:00Z" })], scope)).toThrow("vintage");
+  });
+
+  it("fits a reproducible stat-specific k grid using held-out halves and peer training priors", () => {
+    const rows = [row({ playerId: 1, gameId: 1, shots: 6, toiSeconds: 3600 }), row({ playerId: 1, gameId: 2, shots: 12, toiSeconds: 3600 }),
+      row({ playerId: 2, gameId: 1, shots: 12, toiSeconds: 3600 }), row({ playerId: 2, gameId: 2, shots: 6, toiSeconds: 3600 })];
+    const fit = fitSplitHalfK(rows, scope, [0, 1, 10]);
+    expect(fit).toMatchObject({ status: "candidate", k: 10, boundary: true, unit: "hours", players: 2, evidence: "historical_split_half_tuning_only" });
+    if (fit.status !== "candidate") throw new Error("Expected candidate");
+    expect(fit.trials.find((trial) => trial.k === 0)?.rmse).toBe(6);
+    expect(fit.trials.find((trial) => trial.k === 1)?.rmse).toBe(3);
+    expect(fit).toEqual(fitSplitHalfK([...rows].reverse(), scope, [0, 1, 10]));
+  });
+
+  it("returns an explicit data blocker instead of a research-suggested k", () => {
+    expect(fitSplitHalfK([row()], scope, [0, 1])).toMatchObject({ status: "blocked", reason: "need_two_players_with_two_supported_games" });
+    expect(() => fitSplitHalfK([], scope, [1, 1])).toThrow();
+    expect(() => fitSplitHalfK([], scope, [0, NaN])).toThrow();
+  });
+});
diff --git a/web/lib/projections/research/skater-candidates/priors.ts b/web/lib/projections/research/skater-candidates/priors.ts
new file mode 100644
index 000000000..7e052aee7
--- /dev/null
+++ b/web/lib/projections/research/skater-candidates/priors.ts
@@ -0,0 +1,95 @@
+import { nonNegative, shrinkRate, type Position, type Strength, type CountExposure } from "./accounting";
+
+export type PriorMetric = "shotsPer60" | "goalsPerShot" | "assistsPerOnIceGoal" | "pointsPerOnIceGoal" | "goalsPer60" | "assistsPer60";
+export type HistoricalCounts = {
+  playerId: number; gameId: number; season: string; position: Position; strength: Strength;
+  playedAt: string; availableAt: string;
+  toiSeconds: number | null; shots: number | null; goals: number | null;
+  assists: number | null; onIceGoals: number | null;
+};
+export type PriorScope = { season: string; before: string; position: Position; strength: Strength; metric: PriorMetric };
+
+/** Returns paired raw counts only. Per-game averages cannot stand in for exposures. */
+function pair(row: HistoricalCounts, metric: PriorMetric): CountExposure | null {
+  const onIceShare = metric === "assistsPerOnIceGoal" || metric === "pointsPerOnIceGoal";
+  const events = metric === "pointsPerOnIceGoal" ? row.goals === null || row.assists === null ? null : row.goals + row.assists
+    : metric === "shotsPer60" ? row.shots : metric.startsWith("goals") ? row.goals : row.assists;
+  const exposure = metric === "goalsPerShot" ? row.shots : onIceShare ? row.onIceGoals
+    : row.toiSeconds === null ? null : row.toiSeconds / 3600;
+  if (events === null || exposure === null) return null;
+  nonNegative(events, "historical events"); nonNegative(exposure, "historical exposure");
+  if (events > 0 && exposure === 0) throw new Error("Historical events without exposure");
+  if ((metric === "goalsPerShot" || onIceShare) && events > exposure) throw new Error("Historical share exceeds one");
+  return exposure > 0 ? { events, exposure } : null;
+}
+
+function select(rows: HistoricalCounts[], scope: PriorScope) {
+  const cutoff = Date.parse(scope.before);
+  if (!Number.isFinite(cutoff)) throw new Error("Invalid prior cutoff");
+  const ids = new Set<string>();
+  const selected: { row: HistoricalCounts; pair: CountExposure }[] = [];
+  const excluded = { outsideScope: 0, notAvailableBeforeCutoff: 0, missingExposure: 0 };
+  for (const row of rows) {
+    if (row.season !== scope.season || row.position !== scope.position || row.strength !== scope.strength) { excluded.outsideScope++; continue; }
+    const played = Date.parse(row.playedAt), available = Date.parse(row.availableAt);
+    if (!Number.isFinite(played) || !Number.isFinite(available) || available < played) throw new Error("Invalid historical vintage");
+    if (played >= cutoff || available >= cutoff) { excluded.notAvailableBeforeCutoff++; continue; }
+    if (!Number.isSafeInteger(row.playerId) || !Number.isSafeInteger(row.gameId)) throw new Error("Invalid historical identity");
+    const key = `${row.playerId}:${row.gameId}`;
+    if (ids.has(key)) throw new Error("Duplicate historical player-game-strength");
+    ids.add(key);
+    const counts = pair(row, scope.metric);
+    if (!counts) { excluded.missingExposure++; continue; }
+    selected.push({ row, pair: counts });
+  }
+  selected.sort((a, b) => a.row.playerId - b.row.playerId || Date.parse(a.row.playedAt) - Date.parse(b.row.playedAt) || a.row.gameId - b.row.gameId);
+  return { selected, excluded };
+}
+
+const total = (pairs: CountExposure[]): CountExposure => pairs.reduce((a, b) => ({ events: a.events + b.events, exposure: a.exposure + b.exposure }), { events: 0, exposure: 0 });
+export const priorExposureUnit = (metric: PriorMetric) => metric === "goalsPerShot" ? "shots"
+  : metric === "assistsPerOnIceGoal" || metric === "pointsPerOnIceGoal" ? "onIceGoals" : "hours";
+
+/** Season-current, strength- and position-specific empirical mean. No fallback constants. */
+export function estimatePositionPrior(rows: HistoricalCounts[], scope: PriorScope) {
+  const { selected, excluded } = select(rows, scope);
+  const counts = total(selected.map((entry) => entry.pair));
+  return { scope, unit: priorExposureUnit(scope.metric), ...counts, mean: counts.exposure > 0 ? counts.events / counts.exposure : null,
+    players: new Set(selected.map((entry) => entry.row.playerId)).size, rows: selected.length, excluded };
+}
+
+/**
+ * Deterministic alternating-game halves within the requested historical scope.
+ * Each direction's prior uses only OTHER players' training halves. The peer's
+ * held-out counts never enter the prior. k candidates are supplied, in named
+ * exposure units. This is tuning evidence, not independent predictive evidence.
+ */
+export function fitSplitHalfK(rows: HistoricalCounts[], scope: PriorScope, candidates: number[]) {
+  if (candidates.length < 2 || new Set(candidates).size !== candidates.length) throw new Error("Supply distinct k candidates");
+  candidates.forEach((k) => nonNegative(k, "k"));
+  const { selected, excluded } = select(rows, scope);
+  const players = new Map<number, CountExposure[]>();
+  for (const entry of selected) players.set(entry.row.playerId, [...(players.get(entry.row.playerId) ?? []), entry.pair]);
+  const halves = [...players.entries()].filter(([, entries]) => entries.length >= 2).map(([playerId, entries]) => ({
+    playerId, parts: [total(entries.filter((_, i) => i % 2 === 0)), total(entries.filter((_, i) => i % 2 === 1))],
+  }));
+  if (halves.length < 2) return { status: "blocked" as const, reason: "need_two_players_with_two_supported_games", excluded, unit: priorExposureUnit(scope.metric) };
+  const totals = [0, 1].map((i) => total(halves.map((player) => player.parts[i])));
+  const trials = candidates.map((k) => {
+    let squaredError = 0, error = 0, n = 0;
+    for (const player of halves) for (const direction of [0, 1]) {
+      const train = player.parts[direction], test = player.parts[1 - direction];
+      const peerExposure = totals[direction].exposure - train.exposure;
+      if (peerExposure <= 0) throw new Error("Missing peer training exposure");
+      const mean = (totals[direction].events - train.events) / peerExposure;
+      const predicted = shrinkRate(train, { mean, exposure: k })! * test.exposure;
+      const residual = predicted - test.events;
+      squaredError += residual ** 2; error += residual; n++;
+    }
+    return { k, n, bias: error / n, rmse: Math.sqrt(squaredError / n) };
+  }).sort((a, b) => a.rmse - b.rmse || a.k - b.k);
+  const k = trials[0].k;
+  return { status: "candidate" as const, scope, unit: priorExposureUnit(scope.metric), k, trials,
+    boundary: k === Math.min(...candidates) || k === Math.max(...candidates), players: halves.length, excluded,
+    evidence: "historical_split_half_tuning_only" as const };
+}
diff --git a/web/scripts/forge-skater-candidate-ablation.ts b/web/scripts/forge-skater-candidate-ablation.ts
new file mode 100644
index 000000000..d243ac725
--- /dev/null
+++ b/web/scripts/forge-skater-candidate-ablation.ts
@@ -0,0 +1,146 @@
+import { readFileSync, statSync, writeFileSync } from "node:fs";
+import { createHash } from "node:crypto";
+import { resolve } from "node:path";
+import { clusterBootstrap, summarize, type ScoredRow } from "./forge-counterfactual-backtest";
+
+export type CandidateRow = {
+  gameId: number; playerId: number; position: "F" | "D"; dressed: boolean;
+  actual: Record<string, number | null>;
+  predictions: Record<string, Record<string, number | null>>;
+};
+export type CandidateCohort = {
+  evidence: "synthetic" | "historical_reconstruction" | "frozen_holdout";
+  provenance: string;
+  baseline: string; variants: string[]; heads: string[];
+  fpWeights: Record<string, number>;
+  rows: CandidateRow[];
+};
+type PairedRow = ScoredRow & { position: "F" | "D" };
+const supported = (n: unknown): n is number => typeof n === "number" && Number.isFinite(n) && n >= 0;
+
+function fp(line: Record<string, number | null>, weights: Record<string, number>): number | null {
+  let result = 0;
+  for (const [head, weight] of Object.entries(weights)) {
+    if (weight === 0) continue;
+    if (!supported(line[head])) return null;
+    result += line[head]! * weight;
+  }
+  return result;
+}
+
+/** Paired support per head across ALL variants, with explicit missingness counts. */
+export function pairCandidateCohort(input: CandidateCohort) {
+  if (!input.provenance?.trim() || !["synthetic", "historical_reconstruction", "frozen_holdout"].includes(input.evidence)) throw new Error("Missing cohort provenance");
+  if (input.variants.length < 2 || new Set(input.variants).size !== input.variants.length || !input.variants.includes(input.baseline)) throw new Error("Invalid candidate variants");
+  if (!input.heads.length || input.heads.includes("FP") || new Set(input.heads).size !== input.heads.length) throw new Error("Invalid candidate heads");
+  if (!Object.keys(input.fpWeights).length || !Object.values(input.fpWeights).some((weight) => weight > 0)
+    || Object.entries(input.fpWeights).some(([head, weight]) => !input.heads.includes(head) || !supported(weight))) throw new Error("Invalid FP weights");
+  const heads = [...input.heads, "FP"];
+  const excluded: Record<string, number> = { notDressed: 0 };
+  const rows: PairedRow[] = [];
+  const keys = new Set<string>();
+  for (const source of input.rows) {
+    if (!Number.isSafeInteger(source.gameId) || !Number.isSafeInteger(source.playerId) || !["F", "D"].includes(source.position)) throw new Error("Invalid candidate identity or position");
+    const key = `${source.gameId}:${source.playerId}`;
+    if (keys.has(key)) throw new Error("Duplicate candidate player-game");
+    keys.add(key);
+    if (source.dressed !== true) { excluded.notDressed++; continue; }
+    const actual: Record<string, number | null> = { ...source.actual, FP: fp(source.actual, input.fpWeights) };
+    const predictions: Record<string, Record<string, number | null>> = Object.fromEntries(input.variants.map((variant) => {
+      const line = source.predictions[variant] ?? {};
+      return [variant, { ...line, FP: fp(line, input.fpWeights) }];
+    }));
+    const eligible = heads.filter((head) => {
+      const ok = supported(actual[head]) && input.variants.every((variant) => supported(predictions[variant][head]));
+      if (!ok) excluded[head] = (excluded[head] ?? 0) + 1;
+      return ok;
+    });
+    rows.push({ gameId: source.gameId, playerId: source.playerId, position: source.position, heads: eligible,
+      actual: actual as Record<string, number>, preds: predictions as Record<string, Record<string, number>> });
+  }
+  return { rows, heads, excluded };
+}
+
+function metrics(rows: PairedRow[], variant: string, head: string) {
+  const use = rows.filter((row) => row.heads.includes(head));
+  const summary = summarize(use, variant, head);
+  const xMean = summary.n ? summary.sumPred / summary.n : 0;
+  const yMean = summary.n ? summary.sumActual / summary.n : 0;
+  const variance = use.reduce((sum, row) => sum + (row.preds[variant][head] - xMean) ** 2, 0);
+  const covariance = use.reduce((sum, row) => sum + (row.preds[variant][head] - xMean) * (row.actual[head] - yMean), 0);
+  const slope = use.length >= 2 && variance > 0 ? covariance / variance : null;
+  return { n: summary.n, bias: summary.n ? summary.bias : null, rmse: summary.n ? summary.rmse : null,
+    sumActual: summary.sumActual, sumPredicted: summary.sumPred,
+    actualOverPredicted: summary.sumPred > 0 ? summary.sumActual / summary.sumPred : null,
+    mzSlope: slope, mzIntercept: slope === null ? null : yMean - slope * xMean };
+}
+
+/** Forecast-only ranks, fixed across variants; ID tie-break makes file order irrelevant. */
+function deciles(rows: PairedRow[], baseline: string, rankHead: string) {
+  const sorted = rows.filter((row) => row.heads.includes(rankHead)).sort((a, b) =>
+    a.preds[baseline][rankHead] - b.preds[baseline][rankHead] || a.gameId - b.gameId || a.playerId - b.playerId);
+  return Array.from({ length: 10 }, (_, bin) => sorted.filter((_, i) => Math.ceil((i + 1) * 10 / sorted.length) === bin + 1));
+}
+
+export function scoreCandidateCohort(input: CandidateCohort, reps = 2000) {
+  if (!Number.isSafeInteger(reps) || reps < 1 || reps > 10000) throw new Error("Invalid bootstrap repetitions");
+  const { rows, heads, excluded } = pairCandidateCohort(input);
+  const groups = (["all", "F", "D"] as const).map((position) => {
+    const group = rows.filter((row) => position === "all" || row.position === position);
+    const stats = heads.map((head) => {
+      const use = group.filter((row) => row.heads.includes(head));
+      const headBins = deciles(use, input.baseline, head), fpBins = deciles(group, input.baseline, "FP");
+      return { head, variants: input.variants.map((variant) => ({ variant, ...metrics(use, variant, head),
+        byOwnHeadDecile: deciles(use, variant, head).map((bin, i) => ({ decile: i + 1, ...metrics(bin, variant, head) })),
+        byBaselineHeadDecile: headBins.map((bin, i) => ({ decile: i + 1, ...metrics(bin, variant, head) })),
+        byBaselineFpDecile: fpBins.map((bin, i) => ({ decile: i + 1, ...metrics(bin, variant, head) })),
+        deltaVsBaseline: variant === input.baseline || !use.length ? null : clusterBootstrap(
+          use.map((row) => ({ ...row, preds: { baseline: row.preds[input.baseline], candidate: row.preds[variant] } })), "candidate", head, 1, reps),
+      })) };
+    });
+    return { position, rows: group.length, games: new Set(group.map((row) => row.gameId)).size, stats };
+  });
+  return { evidence: input.evidence, provenance: input.provenance, baseline: input.baseline, variants: input.variants,
+    fpWeights: input.fpWeights, excluded, groups, bootstrap: { seed: 1, reps, unit: "game" },
+    deciles: "Ascending forecast ranks within each position group; fixed baseline head/FP ranks for paired comparisons plus own-head ranks for calibration. Never outcome ranks.",
+    qualification: "Unqualified candidate diagnostics; no automatic release or predictive-skill acceptance. MZ is descriptive without standard errors." };
+}
+
+type AuditRow = {
+  game_id: number; player_id: number; pos: string; actual: Record<string, number | null>;
+  proj: Record<string, Record<string, number | boolean | null>>;
+};
+const AUDIT_SHA256 = "f315992bd0e789b1a6da6e315e3031ef164248a13d2b290e287cb10940a6303b";
+
+/** Adapter for the exact recorded dressed-only audit extract; never fit on these actuals. */
+export function fromHistoricalAudit(bytes: Buffer): CandidateCohort {
+  if (createHash("sha256").update(bytes).digest("hex") !== AUDIT_SHA256) throw new Error("Historical audit hash mismatch");
+  const source = JSON.parse(bytes.toString("utf8")) as AuditRow[];
+  return { evidence: "historical_reconstruction", provenance: `2026-10-21 pre-R19 a/b/a0/b0, reconstructed later; sha256:${AUDIT_SHA256}`,
+    baseline: "a", variants: ["a", "b", "a0", "b0"], heads: ["G", "A", "PPP", "SOG", "HIT", "BLK"],
+    fpWeights: { G: 3, A: 2, PPP: 1, SOG: 0.2, HIT: 0.2, BLK: 0.25 },
+    rows: source.map((row) => ({ gameId: row.game_id, playerId: row.player_id,
+      position: row.pos === "D" ? "D" : ["F", "C", "L", "R", "LW", "RW"].includes(row.pos) ? "F" : (() => { throw new Error("Unknown audit position"); })(),
+      dressed: true, actual: row.actual, predictions: Object.fromEntries(Object.entries(row.proj).map(([variant, line]) => {
+        const sum = (...keys: string[]) => keys.every((key) => supported(line[key])) ? keys.reduce((s, key) => s + (line[key] as number), 0) : null;
+        return [variant, { G: sum("proj_goals_es", "proj_goals_pp"), A: sum("proj_assists_es", "proj_assists_pp"),
+          PPP: sum("proj_goals_pp", "proj_assists_pp"), SOG: sum("proj_shots_es", "proj_shots_pp"), HIT: sum("proj_hits"), BLK: sum("proj_blocks") }];
+      })) })) };
+}
+
+export function runCandidateAblation(argv: string[]) {
+  if (argv.length !== 4 || !["--historical-audit", "--cohort"].includes(argv[0]) || argv[2] !== "--output") throw new Error("Usage: --historical-audit|--cohort INPUT --output OUTPUT");
+  const path = resolve(argv[1]), output = resolve(argv[3]);
+  if (path === output) throw new Error("Refusing to overwrite input");
+  if (statSync(path).size > 64 * 1024 * 1024) throw new Error("Input exceeds 64 MiB");
+  const bytes = readFileSync(path);
+  const cohort = argv[0] === "--historical-audit" ? fromHistoricalAudit(bytes) : JSON.parse(bytes.toString("utf8")) as CandidateCohort;
+  const result = { inputSha256: createHash("sha256").update(bytes).digest("hex"), ...scoreCandidateCohort(cohort) };
+  writeFileSync(output, `${JSON.stringify(result, null, 2)}\n`, { flag: "wx" });
+  return result;
+}
+
+if (require.main === module) {
+  try { const result = runCandidateAblation(process.argv.slice(2)); console.log(JSON.stringify({ evidence: result.evidence, groups: result.groups.map(({ position, rows, games }) => ({ position, rows, games })) })); }
+  catch (error) { console.error(error instanceof Error ? error.message : String(error)); process.exitCode = 1; }
+}
diff --git a/web/scripts/forge-skater-candidate-ablation.test.ts b/web/scripts/forge-skater-candidate-ablation.test.ts

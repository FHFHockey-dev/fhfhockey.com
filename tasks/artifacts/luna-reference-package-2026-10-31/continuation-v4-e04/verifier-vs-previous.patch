+// Only receives disposable synthetic ledger paths from this verifier. Preserve any
+// existing uncertain-outcome stop; fsync the file and directory before proceeding.
+function durableStop(path: string, reason: string) {
+  const ledger = JSON.parse(readFileSync(path, "utf8")); ledger.enabled = false; ledger.blockedReason ??= reason;
+  const pending = `${path}.stop`, fd = openSync(pending, "wx", 0o600);
+  try { writeFileSync(fd, JSON.stringify(ledger)); fsyncSync(fd); } finally { closeSync(fd); }
+  renameSync(pending, path); const directory = openSync(dirname(path), "r");
+  try { fsyncSync(directory); } finally { closeSync(directory); }
+}
 

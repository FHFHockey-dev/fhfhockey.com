+/** Shared by webhook delivery and uncertain-job recovery under the caller's
+ * fenced state lease. Every payment and adjustment is freshly retrieved. */
+export async function reconcilePaidMonthlyInvoice({ stripe, state: current, eventId, invoice, subscription, price, schedule, initialPrice, now }: {
+  stripe: Stripe; state: MonthlyState; eventId: string; invoice: Stripe.Invoice;
+  subscription: Stripe.Subscription; price: Stripe.Price; schedule?: Stripe.SubscriptionSchedule; initialPrice?: Stripe.Price; now: Date;
+}) {
+  const allocations = await stripe.invoicePayments.list({ invoice: invoice.id!, status: "paid", limit: 2 });
+  const payment = allocations.data[0]; const intentId = id(payment?.payment.payment_intent);
+  if (allocations.has_more || allocations.data.length !== 1 || !intentId) throw new Error("Paid invoice allocation ambiguous.");
+  const intent = await stripe.paymentIntents.retrieve(intentId, { expand: ["latest_charge"] });
+  const input = { eventId: `${eventId}:paid`, binding: current.binding, invoice, payment, intent, subscription, price, schedule, initialPrice };
+  const observedVersion = current.version + 1;
+  let state = reduceMonthlyEvent(current, verifiedMonthlyPayment(input), now);
+  const charge = intent.latest_charge as Stripe.Charge;
+  const refunds = await stripe.refunds.list({ charge: charge.id, limit: 100 });
+  const disputes = await stripe.disputes.list({ charge: charge.id, limit: 100 });
+  if (refunds.has_more || disputes.has_more || (charge.disputed && !disputes.data.length) || (charge.amount_refunded > 0 && !refunds.data.length)) throw new Error("Adjustment inventory incomplete.");
+  for (const refund of refunds.data) {
+    const fact = verifiedMonthlyAdjustment({ ...input, eventId: `${eventId}:refund:${refund.id}`, kind: "refund", adjustment: refund, observedAt: now });
+    if (fact.kind !== "refund") throw new Error("Invalid refund snapshot.");
+    state = reduceMonthlyEvent(state, { ...fact, observedVersion }, now);
+  }
+  for (const dispute of disputes.data) state = reduceMonthlyEvent(state, verifiedMonthlyAdjustment({ ...input, eventId: `${eventId}:dispute:${dispute.id}`, kind: "dispute", adjustment: dispute }), now);
+  return state;
+}
+
+export function reconcileMonthlySubscriptionEnd(state: MonthlyState, subscription: Stripe.Subscription, eventId: string, now: Date) {
+  const at = subscription.ended_at;
+  if (subscription.status !== "canceled" || !at) throw new Error("Cancellation time unavailable.");
+  const disputed = subscription.cancellation_details?.reason === "payment_disputed" || Object.values(state.invoices).some((invoice) => Object.keys(invoice.disputes).length > 0);
+  return reduceMonthlyEvent(state, disputed && !state.cancelledAt
+    ? { kind: "billing_stopped", eventId, userId: state.binding.userId, subscriptionId: subscription.id, stoppedAt: new Date(at * 1000).toISOString() }
+    : { kind: "cancelled", eventId, userId: state.binding.userId, subscriptionId: subscription.id, cancelledAt: new Date(at * 1000).toISOString() }, now);
+}

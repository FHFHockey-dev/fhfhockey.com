import type { NextApiRequest, NextApiResponse } from "next";
import { requireApiUser } from "lib/api/requireApiUser";
import { loadProviderSyncAccess } from "lib/integrations/providerSyncAccessServer";
import { createInSeasonCheckout } from "lib/in-season/billing";
import { assertInSeasonSandboxConfiguration, getInSeasonSandboxStripe, MONTHLY_CHECKOUT_BLOCKER } from "lib/in-season/billingConfig";
import { inSeasonBillingStore } from "lib/in-season/billingStore";

export default async function handler(req: NextApiRequest, res: NextApiResponse) {
  res.setHeader("Cache-Control", "private, no-store");
  if (req.method === "GET") {
    let available = false;
    try { assertInSeasonSandboxConfiguration(); available = true; } catch { /* Disabled until test setup is approved. */ }
    return res.status(200).json({ data: { seasonPassAvailable: available, monthlyAvailable: false } });
  }
  if (req.method !== "POST") { res.setHeader("Allow", "GET, POST"); return res.status(405).end(); }
  // No external Auth/DB/Stripe calls until isolated sandbox configuration passes.
  if (!req.headers.authorization) return res.status(401).json({ error: "Sign in to choose premium access." });
  let origin: string;
  try { ({ origin } = assertInSeasonSandboxConfiguration()); }
  catch { return res.status(503).json({ error: "Checkout is not available yet." }); }
  const user = await requireApiUser(req, res);
  if (!user) return;
  if (!req.body || Object.keys(req.body).some((key) => key !== "plan") || !["season_pass", "monthly"].includes(req.body.plan)) return res.status(400).json({ error: "Choose a valid plan." });
  if (req.body.plan === "monthly") return res.status(409).json({ error: MONTHLY_CHECKOUT_BLOCKER });
  try {
    const access = await loadProviderSyncAccess(user.id);
    if (typeof access.eligible !== "boolean" || access.reason === "verification_unavailable") return res.status(503).json({ error: "Existing access could not be checked. Please try again." });
    if (access.eligible) return res.status(409).json({ error: "Premium sync is already active for this account." });
    const data = await createInSeasonCheckout({ stripe: getInSeasonSandboxStripe(), store: inSeasonBillingStore(), userId: user.id, origin, plan: req.body.plan });
    return res.status(200).json({ data });
  } catch { return res.status(503).json({ error: "Checkout could not be started. Please try again." }); }
}

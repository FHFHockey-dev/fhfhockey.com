+  it.each([{ data: { user: null }, error: null }, { data: { user: { id: "forged-user" } }, error: { message: "expired" } }])("rejects invalid/expired sessions before role and edition reads", async result => {
+    auth.getUser.mockResolvedValueOnce(result);

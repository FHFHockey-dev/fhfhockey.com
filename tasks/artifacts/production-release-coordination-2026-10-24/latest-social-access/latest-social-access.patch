+  if (focus === "blocks") return `${n(recent.blocksPerGame, 1)} BLK/GP · ${n(recent.points)} P · ${toi} TOI`;
+  if (focus === "shots") return `${n(recent.shots)} SOG · ${n(recent.goals)} G · ${toi} TOI`;

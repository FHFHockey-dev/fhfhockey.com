+  return Object.fromEntries((["hits", "shots", "blocks"] as const).map(category => [category,
+    fillThree(pool.map(player => ({ ...player, perGame: player[category]! / player.gamesPlayed })), (a, b) => b.perGame - a.perGame || tieBreak(a, b))])) as Record<SpecialistCategory, Specialist[]>;
+}

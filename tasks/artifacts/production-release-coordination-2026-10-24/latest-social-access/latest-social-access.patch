--- /dev/null
+++ b/web/lib/socialShare/teamRates.ts
@@ -0,0 +1,36 @@
+import publicSupabase from "lib/supabase/public-client";
+import { fetchAllSupabasePages } from "lib/supabase/pagination";
+import type { ShareTeamRateRow } from "./matchups";
+
+/** One season and one situation is about 32 rows; anything past this is refused, never paged on. */
+export const TEAM_RATE_ROW_LIMIT = 64;
+const TEAM_RATE_COLUMNS = "team_abbreviation,gp,xgf,xga,gf,ga,sf,sa,season,situation,updated_at";
+type TeamRateSourceRow = ShareTeamRateRow & { team_abbreviation: string | null };
+
+/**
+ * Social-share copy of Game Grid's loadCurrentSeasonStats rules (exact count, one season,
+ * situation "all", unique abbreviations), reading only the rate columns with an explicit row limit.
+ */
+export async function loadShareTeamRates(season: number): Promise<Record<string, ShareTeamRateRow>> {
+  let expected: number | null = null;
+  const rows = await fetchAllSupabasePages<TeamRateSourceRow>(async ({ from, to }) => {
+    const { data, error, count } = await publicSupabase.from("nst_team_stats")
+      .select(TEAM_RATE_COLUMNS, { count: "exact" })
+      .eq("season", season).eq("situation", "all")
+      .order("team_abbreviation", { ascending: true }).range(from, to);
+    if (!error) {
+      if (count == null || !Number.isFinite(count) || count < 0 || (expected != null && count !== expected)) throw new Error("Team rate completeness changed or is unavailable.");
+      expected = count;
+    }
+    return { data: data as unknown as TeamRateSourceRow[] | null, error };
+  }, { pageSize: TEAM_RATE_ROW_LIMIT, limit: TEAM_RATE_ROW_LIMIT });
+  // A count above the limit leaves rows short of it, so an oversized source fails closed.
+  if (expected === null || rows.length !== expected) throw new Error("Team rate response was incomplete or over the row limit.");
+  const rates: Record<string, ShareTeamRateRow> = {};
+  for (const row of rows) {
+    const abbreviation = row.team_abbreviation?.trim().toUpperCase();
+    if (!abbreviation || row.season !== season || row.situation !== "all" || rates[abbreviation]) throw new Error("Team rate row identity was invalid or ambiguous.");
+    rates[abbreviation] = { gp: row.gp, xgf: row.xgf, xga: row.xga, gf: row.gf, ga: row.ga, sf: row.sf, sa: row.sa, season: row.season, situation: row.situation, updated_at: row.updated_at };
+  }
+  return rates;
+}
diff --git a/web/lib/socialShare/tiers.test.ts b/web/lib/socialShare/tiers.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9122f8221b1e05e395ae9dd217cd6bd049ea9631
--- /dev/null
+++ b/web/lib/socialShare/tiers.test.ts
@@ -0,0 +1,78 @@
+import { describe, expect, it } from "vitest";
+import { buildScheduleSnapshot } from "./schedule";
+import { fictionalLeagueWeek } from "./fixtures";
+import { fictionalPlayerSources } from "./pickupsFixture";
+import { buildPlayerLayer, trimPlayerLayer } from "./players";
+import { allocateRows, schedulePairs, streamingTiers, tierPairs, TIER_LIST_ROWS } from "./tiers";
+import type { ShareTeamRow, SocialShareSnapshot } from "./types";
+
+const weekStart = "2026-10-26", now = "2026-10-26T12:00:00Z", season = 20262027;
+function edition(): SocialShareSnapshot {
+  const snapshot = buildScheduleSnapshot({ format: "game-grid", weekStart, generatedAt: now, schedule: fictionalLeagueWeek(weekStart, now) });
+  return { ...snapshot, players: buildPlayerLayer(fictionalPlayerSources(season, "2026-10-26", "2026-10-26T08:00:00Z"), { season, teams: snapshot.teams.map(team => team.abbreviation), fetchedAt: now, generatedAt: now }) };
+}
+// TJ's Oct 26 – Nov 1 example as synthetic rows, with Week Scores in Game Grid's order (4/1 above 3/2 by design).
+const row = (abbreviation: string, rank: number, score: number, remainingGames: number, offNightGames: number) =>
+  ({ team: { id: rank, abbreviation, name: abbreviation }, rank, score, remainingGames, offNightGames, weightedOffNights: 0, games: [] }) as ShareTeamRow;
+const example = [row("CGY", 1, 20, 4, 3), row("EDM", 2, 19.5, 4, 3), row("WPG", 3, 15, 4, 2), row("LAK", 4, 12, 4, 1), row("OTT", 5, 11.8, 4, 1),
+  row("TOR", 6, 10, 3, 2), row("NJD", 7, 9.9, 3, 2), row("PHI", 8, 9.8, 3, 2), row("WSH", 9, 9.5, 3, 2), row("BOS", 10, 7, 3, 1), row("SEA", 11, 0, 0, 0)];
+const names = (tiers: { teams: ShareTeamRow[] }[][]) => tiers.map(tier => tier.flatMap(pair => pair.teams.map(team => team.team.abbreviation)));
+
+describe("schedule pairs and tiers", () => {
+  it("groups teams by exact (GP, off-nights), ties together, best Week Score first, teams by rank", () => {
+    const pairs = schedulePairs({ rows: example });
+    expect(pairs.map(pair => `${pair.gp}/${pair.off}`)).toEqual(["4/3", "4/2", "4/1", "3/2", "3/1"]);
+    expect(pairs[0].teams.map(team => team.team.abbreviation)).toEqual(["CGY", "EDM"]);
+    expect(pairs.flatMap(pair => pair.teams).some(team => team.remainingGames === 0)).toBe(false);
+  });
+
+  it("reproduces TJ's example week: strict T1 4/3, T2 4/2, T3 4/1; widen folds 4/1 into T2 and makes T3 = 3/2", () => {
+    const pairs = schedulePairs({ rows: example });
+    expect(names(tierPairs(pairs, "strict"))).toEqual([["CGY", "EDM"], ["WPG"], ["LAK", "OTT"]]);
+    expect(names(tierPairs(pairs, "widened"))).toEqual([["CGY", "EDM"], ["WPG", "LAK", "OTT"], ["TOR", "NJD", "PHI", "WSH", "BOS"]]);
+    expect(tierPairs(pairs.slice(0, 2), "strict")).toHaveLength(2);
+    expect(tierPairs([], "widened")).toEqual([]);
+  });
+
+  it("allocates the row budget fairly, leftovers to earlier tiers, one note row for an empty tier", () => {
+    expect(allocateRows([10, 10, 10])).toEqual([5, 5, 5]);
+    expect(allocateRows([2, 10, 10])).toEqual([2, 8, 5]);
+    expect(allocateRows([0, 10, 10])).toEqual([0, 7, 7]);
+    expect(allocateRows([3, 2, 1])).toEqual([3, 2, 1]);
+    expect(allocateRows([40, 40, 40]).reduce((sum, value) => sum + value, 0)).toBe(TIER_LIST_ROWS);
+  });
+});
+
+describe("streaming tier players", () => {
+  it("lists only under-50% players from tier teams, tier order before rate, within budget with +N more", () => {
+    const snapshot = edition();
+    for (const mode of ["strict", "widened"] as const) {
+      const tiers = streamingTiers(snapshot, true, mode);
+      expect(tiers.length).toBe(3);
+      for (const tier of tiers) {
+        const teams = new Set(tier.teams.map(team => team.abbreviation));
+        for (const player of tier.players) { expect(teams.has(player.team)).toBe(true); expect(player.ownership).toBeLessThan(50); }
+        const skaters = tier.players.filter(player => player.group !== "G"), goalies = tier.players.filter(player => player.group === "G");
+        expect(tier.players).toEqual([...skaters, ...goalies]);
+        for (let i = 1; i < skaters.length; i++) expect(skaters[i - 1].pointsPerGame!).toBeGreaterThanOrEqual(skaters[i].pointsPerGame!);
+        expect(tier.shown).toEqual(tier.players.slice(0, tier.shown.length));
+        expect(tier.more).toBe(tier.players.length - tier.shown.length);
+      }
+      expect(tiers.reduce((sum, tier) => sum + tier.shown.length, 0)).toBeLessThanOrEqual(TIER_LIST_ROWS);
+      // No team appears in two tiers, so tier order always takes precedence over rate.
+      const all = tiers.flatMap(tier => tier.teams.map(team => team.abbreviation));
+      expect(new Set(all).size).toBe(all.length);
+    }
+  });
+
+  it("keeps an empty tier, and lists nothing when untrusted or when a live layer was trimmed", () => {
+    const snapshot = edition(), [first] = streamingTiers(snapshot, true, "strict");
+    const emptied = { ...snapshot, players: { ...snapshot.players!, players: snapshot.players!.players.filter(player => !first.teams.some(team => team.abbreviation === player.team)) } };
+    const tiers = streamingTiers(emptied, true, "strict");
+    expect(tiers[0]).toMatchObject({ players: [], shown: [], more: 0 });
+    expect(tiers[1].shown.length).toBeGreaterThan(0);
+    expect(streamingTiers(snapshot, false, "strict")).toEqual([]);
+    const trimmed = { ...snapshot, players: trimPlayerLayer(snapshot, snapshot.players!) };
+    expect(streamingTiers(trimmed, true, "strict").every(tier => tier.players.length === 0)).toBe(true);
+  });
+});
diff --git a/web/lib/socialShare/tiers.ts b/web/lib/socialShare/tiers.ts
new file mode 100644
index 0000000000000000000000000000000000000000..87a67fa83e919bcd15d204355d23cdffb2707bc6
--- /dev/null
+++ b/web/lib/socialShare/tiers.ts
@@ -0,0 +1,83 @@
+import { playersReady, type RankedPlayer } from "./players";
+import type { ShareTeam, ShareTeamRow, SocialShareSnapshot } from "./types";
+
+/**
+ * Schedule-aware streaming tiers (TJ, ticket 13). Teams with games are grouped by their exact
+ * (GP, off-nights) pair; pairs are ordered by Game Grid Week Score (the best team's score in the pair,
+ * TJ's pop-up choice), so the order matches the Best Schedules grid. Only the top three tiers show.
+ * Strict: one pair per tier. Widen: from Tier 2 down, each tier also takes the next pair, so on TJ's
+ * Oct 26 week Tier 2 = 4/2 + 4/1 (WPG, LAK, OTT) and Tier 3 = 3/2 (+ the next pair).
+ */
+export const TIER_COUNT = 3;
+/** Player rows across all three tiers; a tier that runs out says "+N more" instead of shrinking text. */
+export const TIER_LIST_ROWS = 15;
+
+export type TierMode = "strict" | "widened";
+export type SchedulePair = { gp: number; off: number; teams: ShareTeamRow[]; bestScore: number };
+export type StreamingTier = { index: number; pairs: SchedulePair[]; teams: ShareTeam[]; players: RankedPlayer[]; shown: RankedPlayer[]; more: number };
+
+/** Distinct (GP, off-nights) pairs of teams with games, best Week Score first; teams inside by rank. */
+export function schedulePairs(snapshot: Pick<SocialShareSnapshot, "rows">): SchedulePair[] {
+  const groups = new Map<string, ShareTeamRow[]>();
+  for (const row of snapshot.rows.filter(item => item.remainingGames > 0)) {
+    const key = `${row.remainingGames}/${row.offNightGames}`;
+    groups.set(key, [...(groups.get(key) ?? []), row]);
+  }
+  return [...groups.values()].map(teams => {
+    const sorted = [...teams].sort((a, b) => a.rank - b.rank || a.team.abbreviation.localeCompare(b.team.abbreviation));
+    return { gp: sorted[0].remainingGames, off: sorted[0].offNightGames, teams: sorted, bestScore: Math.max(...sorted.map(team => team.score)) };
+  }).sort((a, b) => b.bestScore - a.bestScore || b.gp - a.gp || b.off - a.off);
+}
+
+/** The pairs in each shown tier for the mode. */
+export function tierPairs(pairs: SchedulePair[], mode: TierMode): SchedulePair[][] {
+  if (mode === "strict") return pairs.slice(0, TIER_COUNT).map(pair => [pair]);
+  // Widen: Tier 1 keeps the best pair alone; Tiers 2 and 3 each fold in the next pair.
+  return [pairs.slice(0, 1), pairs.slice(1, 3), pairs.slice(3, 5)].filter(tier => tier.length > 0);
+}
+
+/** Split the row budget: an equal share each (capped by its players), leftovers to earlier tiers first; an empty tier keeps one row for its note. */
+export function allocateRows(counts: number[], capacity = TIER_LIST_ROWS): number[] {
+  const reserved = counts.filter(count => count === 0).length, budget = Math.max(0, capacity - reserved);
+  const active = counts.filter(count => count > 0).length;
+  const share = active ? Math.floor(budget / active) : 0;
+  const rows = counts.map(count => Math.min(count, share));
+  let left = budget - rows.reduce((sum, value) => sum + value, 0);
+  for (let i = 0; i < counts.length && left > 0; i++) {
+    const add = Math.min(left, counts[i] - rows[i]);
+    rows[i] += add; left -= add;
+  }
+  return rows;
+}
+
+/** Existing per-player rate: skaters by points per game first, then goalies by quality-start %, then save %. */
+const listOrder = (a: RankedPlayer, b: RankedPlayer) => Number(a.group === "G") - Number(b.group === "G")
+  || (a.group === "G" ? (b.qualityStartPct ?? -1) - (a.qualityStartPct ?? -1) || (b.savePct ?? -1) - (a.savePct ?? -1) : (b.pointsPerGame ?? -1) - (a.pointsPerGame ?? -1))
+  || a.weekRank - b.weekRank || a.ownership - b.ownership || a.name.localeCompare(b.name) || a.nhlId - b.nhlId;
+
+/**
+ * The tier list needs every under-50% player on the tier teams. A live layer is trimmed server-side to
+ * the pickup and specialist cards' players (it carries `selectedDates`), so until the server also keeps
+ * tier rows, the card reports itself unavailable instead of listing an incomplete set.
+ */
+export const tierPlayersAvailable = (snapshot: SocialShareSnapshot) => playersReady(snapshot) && !snapshot.players?.selectedDates;
+
+/**
+ * Players under 50% rostered on each tier's teams only, tier order before rate. `shown` fits the row
+ * budget; `more` counts the rest.
+ */
+export function streamingTiers(snapshot: SocialShareSnapshot, trusted: boolean, mode: TierMode): StreamingTier[] {
+  if (!trusted) return [];
+  const ready = tierPlayersAvailable(snapshot), rows = new Map(snapshot.rows.map(row => [row.team.abbreviation, row]));
+  const tiers = tierPairs(schedulePairs(snapshot), mode).map((pairs, index) => {
+    const teams = pairs.flatMap(pair => pair.teams);
+    const names = new Set(teams.map(row => row.team.abbreviation));
+    const players = !ready ? [] : (snapshot.players?.players ?? []).filter(player => names.has(player.team) && player.ownership < 50).map(player => {
+      const row = rows.get(player.team)!;
+      return { ...player, weekRank: row.rank, remainingGames: row.remainingGames, offNightGames: row.offNightGames, widened: false };
+    }).sort(listOrder);
+    return { index: index + 1, pairs, teams: teams.map(row => row.team), players };
+  });
+  const allocation = allocateRows(tiers.map(tier => tier.players.length));
+  return tiers.map((tier, i) => ({ ...tier, shown: tier.players.slice(0, allocation[i]), more: tier.players.length - allocation[i] }));
+}
diff --git a/web/lib/socialShare/trends.test.ts b/web/lib/socialShare/trends.test.ts

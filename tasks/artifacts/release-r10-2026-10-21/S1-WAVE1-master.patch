@@ -0,0 +1,113 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { forecastSourceSummary, selectForecastServingSource } from "./forecastServingSource";
+import { NATIVE_CATALOG_PIN_KEYS, prepareNativeCatalogObservation } from "./nativeCatalogHead";
+import { playerForecastSourcePayloadHash as hash, type PlannedSourceObservation } from "./sourceSnapshot";
+
+// Same synthetic catalog shape as nativeCatalogHead.test.ts; selection only, no publication.
+const now = new Date("2026-10-15T12:00:00Z");
+const ids = [1, 2, 3, 4].map(n => `00000000-0000-4000-8000-${String(n).padStart(12, "0")}`);
+const seasonId = 20262027;
+const expiresAt = "2026-10-15T18:00:00.000Z";
+
+function release(id: string, dataset: string, expiry: string): PlannedSourceObservation {
+  const payload = { manifest: { expiresAt: expiry } };
+  return { id, provider: "fhfh", dataset_key: dataset, entity_kind: "bundle", entity_key: String(seasonId), source_url: null,
+    source_revision_key: null, observed_at: "2026-10-15T10:00:00Z", available_at: "2026-10-15T10:00:00Z",
+    payload_hash: hash(payload), payload, metadata: {} };
+}
+
+function selectedCatalog() {
+  const baseline = release(ids[2], "contribution-bundle-v1", expiresAt);
+  const skaters = release(ids[3], "skater-roster-observation-participation-bundle-v1", "2026-10-15T22:59:59.999Z");
+  const observation = prepareNativeCatalogObservation({ plan: { seasonId, rows: [baseline, skaters] }, observationId: ids[1],
+    issuedAt: now.toISOString(), pins: { PLAYER_FORECAST_BASELINE_RELEASE_IDS: baseline.id,
+      PLAYER_FORECAST_ROSTER_OBSERVATION_SKATER_PARTICIPATION_RELEASES: `${skaters.id}:${skaters.payload_hash}` } });
+  const head = { id: ids[0], season_id: seasonId, revision: 4, observation_id: observation.id,
+    payload_hash: observation.payload_hash, selected_at: now.toISOString() };
+  const tables: Record<string, Record<string, unknown>[]> = { native_forecast_catalog_heads: [head],
+    player_forecast_source_observations: [observation, baseline, skaters] };
+  const from = vi.fn((table: string) => {
+    let rows = [...(tables[table] ?? [])];
+    const query: any = {
+      select: () => query,
+      eq: (column: string, value: unknown) => { rows = rows.filter(row => row[column] === value); return query; },
+      in: (column: string, values: unknown[]) => { rows = rows.filter(row => values.includes(row[column])); return query; },
+      limit: (count: number) => { rows = rows.slice(0, count); return query; },
+      abortSignal: () => query,
+      then: (resolve: (value: unknown) => unknown, reject?: (error: unknown) => unknown) =>
+        Promise.resolve({ data: structuredClone(rows), error: null }).then(resolve, reject),
+    };
+    return query;
+  });
+  return { db: { from } as never, from };
+}
+
+const stalePins = { PLAYER_FORECAST_BASELINE_RELEASE_IDS: "stale-process-pin", PLAYER_FORECAST_PARTICIPATION_RELEASES: "stale-legacy-pin" };
+const fallbacks = [undefined, "empty", "legacy_flagged", "LEGACY_FLAGGED", "legacy"] as const;
+const env = (headId: string | undefined, fallback: string | undefined) => ({ ...stalePins,
+  ...(headId === undefined ? {} : { PLAYER_FORECAST_NATIVE_CATALOG_HEAD_ID: headId }),
+  ...(fallback === undefined ? {} : { FORGE_NATIVE_SERVING_FALLBACK: fallback }) });
+const fallbackKind = (fallback: string | undefined) => fallback === "legacy_flagged" ? "legacy_flagged" : "empty";
+
+afterEach(() => vi.useRealTimers());
+
+describe("forecast serving source selection", () => {
+  it.each(fallbacks)("selects legacy with the process pins and no lookup while the head env is unset (fallback=%s)", async fallback => {
+    const { db, from } = selectedCatalog(), environment = env(undefined, fallback);
+    const source = await selectForecastServingSource(db, seasonId, now, environment);
+    expect(source).toEqual({ kind: "legacy", reason: "native_not_activated", environment });
+    expect(from).not.toHaveBeenCalled();
+  });
+
+  it("never resolves a lazy season before activation", async () => {
+    const { db } = selectedCatalog(), season = vi.fn(async () => seasonId);
+    expect((await selectForecastServingSource(db, season, now, env(undefined, undefined))).kind).toBe("legacy");
+    expect(season).not.toHaveBeenCalled();
+  });
+
+  it.each(fallbacks)("selects native from the head's pins only, whatever the fallback (fallback=%s)", async fallback => {
+    const { db } = selectedCatalog();
+    const source = await selectForecastServingSource(db, async () => seasonId, now, env(ids[0], fallback));
+    expect(source).toMatchObject({ kind: "native", headId: ids[0], headRevision: 4, issuedAt: now.toISOString(), expiresAt });
+    expect(source.environment.PLAYER_FORECAST_BASELINE_RELEASE_IDS).toBe(ids[2]);
+    expect(source.environment.PLAYER_FORECAST_PARTICIPATION_RELEASES).toBe("");
+    expect(forecastSourceSummary(source)).toEqual({ kind: "native", headRevision: 4, expiresAt, reason: null });
+  });
+
+  it.each(fallbacks.flatMap(fallback => [Date.parse(expiresAt), Date.parse(expiresAt) + 1].map(at => [fallback, at] as const)))(
+    "falls back with native_catalog_expired at and after expiry (fallback=%s, clock=%s)", async (fallback, at) => {
+      const { db } = selectedCatalog();
+      const source = await selectForecastServingSource(db, seasonId, new Date(at), env(ids[0], fallback));
+      expect(source.kind).toBe(fallbackKind(fallback));
+      expect(forecastSourceSummary(source)).toEqual({ kind: fallbackKind(fallback), headRevision: null, expiresAt: null, reason: "native_catalog_expired" });
+      for (const key of NATIVE_CATALOG_PIN_KEYS) expect(source.environment[key]).toBe("");
+      expect(source.environment.PLAYER_FORECAST_PARTICIPATION_RELEASES).toBe("");
+    });
+
+  it.each(fallbacks.flatMap(fallback => [["missing head", ids[3]], ["malformed head ID", "not-a-uuid"], ["other season", ids[0]]]
+    .map(([label, headId]) => [fallback, label, headId] as const)))(
+    "falls back with head_unavailable_or_invalid, never keeping process pins (fallback=%s, %s)", async (fallback, label, headId) => {
+      const { db } = selectedCatalog();
+      const source = await selectForecastServingSource(db, label === "other season" ? 20252026 : seasonId, now, env(headId, fallback));
+      expect(source).toMatchObject({ kind: fallbackKind(fallback), reason: "native_catalog_head_unavailable_or_invalid" });
+      for (const key of NATIVE_CATALOG_PIN_KEYS) expect(source.environment[key]).toBe("");
+    });
+
+  it.each([undefined, "legacy_flagged"])("counts an 8 s deadline miss as unavailable (fallback=%s)", async fallback => {
+    vi.useFakeTimers();
+    const hung = { from: () => { const query: any = { select: () => query, eq: () => query, in: () => query, limit: () => query,
+      abortSignal: () => query, then: () => undefined }; return query; } } as never;
+    const pending = selectForecastServingSource(hung, seasonId, now, env(ids[0], fallback));
+    await vi.advanceTimersByTimeAsync(7999);
+    let settled = false; void pending.then(() => { settled = true; });
+    await Promise.resolve(); expect(settled).toBe(false);
+    await vi.advanceTimersByTimeAsync(1);
+    expect(await pending).toMatchObject({ kind: fallbackKind(fallback), reason: "native_catalog_head_unavailable_or_invalid" });
+  });
+
+  it("falls back when the season itself cannot be resolved", async () => {
+    const { db } = selectedCatalog();
+    const source = await selectForecastServingSource(db, async () => { throw new Error("no season"); }, now, env(ids[0], undefined));
+    expect(source).toMatchObject({ kind: "empty", reason: "native_catalog_head_unavailable_or_invalid" });
+  });
+});
diff --git a/web/lib/player-forecasts/forecastServingSource.ts b/web/lib/player-forecasts/forecastServingSource.ts
new file mode 100644
index 0000000..0149b39
--- /dev/null
+++ b/web/lib/player-forecasts/forecastServingSource.ts
@@ -0,0 +1,79 @@
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { timestampMicros } from "../projections/evidenceTime";
+import { withinDeadline } from "../rosterScheduleData/planningInputs";
+import { resolveNativeCatalogEnvironment, unavailableNativeCatalogEnvironment, type NativeCatalogHead } from "./nativeCatalogHead";
+import { validPlannedObservationId } from "./sourceSnapshot";
+
+/** Same budget as the planning head read; a miss counts as an unavailable head. */
+export const FORECAST_SERVING_DEADLINE_MS = 8000;
+export type NativeUnavailableReason = "native_catalog_head_unavailable_or_invalid" | "native_catalog_expired";
+type ServingEnvironment = Readonly<Record<string, string | undefined>>;
+/** `environment` is what the forecast loaders read: the process env before
+ * activation, the head's pins only for native, and blank pins otherwise. */
+export type ForecastServingSource =
+  | { kind: "legacy"; reason: "native_not_activated"; environment: ServingEnvironment }
+  | { kind: "native"; headId: string; headRevision: number; issuedAt: string; expiresAt: string; environment: ServingEnvironment }
+  | { kind: "legacy_flagged" | "empty"; reason: NativeUnavailableReason; environment: ServingEnvironment };
+export type ForecastSourceSummary = { kind: ForecastServingSource["kind"]; headRevision: number | null; expiresAt: string | null; reason: string | null };
+
+const micros = (value: unknown) => typeof value === "string" ? Number(timestampMicros(value) ?? NaN) : NaN;
+
+/** Pre-activation is legacy; a configured but unusable head never keeps the process pins (D-2: anything but `legacy_flagged` is `empty`). */
+export function unavailableForecastServingSource(env: ServingEnvironment, reason: NativeUnavailableReason = "native_catalog_head_unavailable_or_invalid"): ForecastServingSource {
+  if (!env.PLAYER_FORECAST_NATIVE_CATALOG_HEAD_ID) return { kind: "legacy", reason: "native_not_activated", environment: env };
+  return { kind: env.FORGE_NATIVE_SERVING_FALLBACK === "legacy_flagged" ? "legacy_flagged" : "empty", reason,
+    environment: unavailableNativeCatalogEnvironment({ ...env }).environment };
+}
+
+export function forecastSourceSummary(source: ForecastServingSource): ForecastSourceSummary {
+  return source.kind === "native" ? { kind: "native", headRevision: source.headRevision, expiresAt: source.expiresAt, reason: null }
+    : { kind: source.kind, headRevision: null, expiresAt: null, reason: source.reason };
+}
+
+function linkSignals(deadline: AbortSignal, external?: AbortSignal) {
+  if (!external) return deadline;
+  const controller = new AbortController(), abort = () => controller.abort();
+  if (deadline.aborted || external.aborted) abort();
+  deadline.addEventListener("abort", abort, { once: true }); external.addEventListener("abort", abort, { once: true });
+  return controller.signal;
+}
+
+/** The immutable selection row behind a head, read for its issuance window only.
+ * On success the resolver has already validated this row against the same clock. */
+async function readSelectionWindow(db: SupabaseClient<any>, headId: string, seasonId: number, signal: AbortSignal, known?: NativeCatalogHead) {
+  let head = known;
+  if (!head) {
+    const result = await db.from("native_forecast_catalog_heads").select("id,season_id,revision,observation_id,payload_hash").eq("id", headId).limit(2).abortSignal(signal);
+    if (result.error || !Array.isArray(result.data) || result.data.length !== 1 || result.data[0].season_id !== seasonId) return null;
+    head = result.data[0] as NativeCatalogHead;
+  }
+  const result = await db.from("player_forecast_source_observations").select("id,payload_hash,payload").eq("id", head.observation_id).limit(2).abortSignal(signal);
+  const row = Array.isArray(result.data) && result.data.length === 1 ? result.data[0] : null;
+  const issuedAt = row?.payload?.issuedAt, expiresAt = row?.payload?.expiresAt;
+  if (result.error || !row || row.payload_hash !== head.payload_hash || !Number.isFinite(micros(issuedAt)) || !Number.isFinite(micros(expiresAt))) return null;
+  return { head, issuedAt: issuedAt as string, expiresAt: expiresAt as string };
+}
+
+/** The single server-side forecast source for Start Chart, RSO and FORGE (one call per request).
+ * `seasonId` may be lazy so pre-activation requests make no lookups at all. */
+export async function selectForecastServingSource(db: SupabaseClient<any>, seasonId: number | (() => Promise<number>), now = new Date(),
+  env: ServingEnvironment = process.env, signal?: AbortSignal): Promise<ForecastServingSource> {
+  const headId = env.PLAYER_FORECAST_NATIVE_CATALOG_HEAD_ID;
+  if (!headId) return unavailableForecastServingSource(env);
+  try {
+    return await withinDeadline(Date.now() + FORECAST_SERVING_DEADLINE_MS, async deadlineSignal => {
+      const linked = linkSignals(deadlineSignal, signal);
+      const season = typeof seasonId === "function" ? await seasonId() : seasonId;
+      const resolved = await resolveNativeCatalogEnvironment(db, season, now, { ...env }, linked);
+      const expired = (window: { expiresAt: string } | null) => !!window && micros(window.expiresAt) <= now.getTime() * 1000;
+      if (resolved.selection) {
+        const window = await readSelectionWindow(db, headId, season, linked, resolved.selection);
+        if (!window || expired(window)) return unavailableForecastServingSource(env, window ? "native_catalog_expired" : undefined);
+        return { kind: "native", headId, headRevision: window.head.revision, issuedAt: window.issuedAt, expiresAt: window.expiresAt, environment: resolved.environment };
+      }
+      // The resolver reports every failure alike; only an expired selection gets its own reason.
+      const window = validPlannedObservationId(headId) ? await readSelectionWindow(db, headId, season, linked).catch(() => null) : null;
+      return unavailableForecastServingSource(env, expired(window) ? "native_catalog_expired" : undefined);
+    });
+  } catch { return unavailableForecastServingSource(env); }
+}

+    if (kind === "future evidence") observation.evidence.capturedAt = "2026-10-15T10:00:00.000001Z";
+    expect(() => buildRosterObservationSkaterParticipationReceipt(input, issuance)).toThrow();
+  });
+  it.each(["route", "hash", "body club", "body abbreviation", "body season", "missing group", "duplicate player"])("authenticates original official roster %s", kind => {
+    const raw: any = { teamId: 1, seasonId: 20262027, forwards: [{ id: 77 }], defensemen: [], goalies: [] };
+    if (kind === "body club") raw.teamId = 2;
+    if (kind === "body abbreviation") raw.teamAbbrev = "WRONG";
+    if (kind === "body season") raw.seasonId = 20252026;
+    if (kind === "missing group") delete raw.goalies;
+    if (kind === "duplicate player") raw.goalies.push({ id: 77 });
+    const rawBody = JSON.stringify(raw);
+    expect(() => targetRosterObservationFromReceipt({ playerId: 7, nhlPlayerId: 77, teamId: 1,
+      seasonId: 20262027, teamAbbreviation: "TST", knownConflict: null, cutoffAt: cutoff,
+      receipt: { url: `https://api-web.nhle.com/v1/roster/TST/${kind === "route" ? "current" : "20262027"}`,
+        capturedAt: "2026-10-15T09:00:00Z", rawBody,
+        bodySha256: kind === "hash" ? "a".repeat(64) : createHash("sha256").update(rawBody).digest("hex") } })).toThrow();
+  });
+  it("uses a separate default-denied exact-hash observation release", async () => {

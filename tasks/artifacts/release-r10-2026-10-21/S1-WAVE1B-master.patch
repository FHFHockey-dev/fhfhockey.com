+    const id = "11111111-1111-4111-8111-111111111111", row = { id, provider: "fhfh", dataset_key: payload.version,
+      entity_kind: "participation_bundle", entity_key: "20262027", available_at: issuance.issuedAt, payload_hash: playerForecastSourcePayloadHash(payload), payload };
+    const reply = Promise.resolve({ data: [row], error: null });
+    const chain: any = new Proxy({}, { get: (_, key) => key === "then" ? reply.then.bind(reply) : () => chain });
+    const db = { from: vi.fn(() => chain) };
+    expect((await loadRosterObservationSkaterParticipation(db as never, 20262027, new Date(issuance.issuedAt),
+      { environment: { PLAYER_FORECAST_FROZEN_WINDOW_SKATER_PARTICIPATION_RELEASES: `${id}:${row.payload_hash}` } })).sources).toEqual([]);
+    expect(db.from).not.toHaveBeenCalled();
+    const options = { environment: { PLAYER_FORECAST_ROSTER_OBSERVATION_SKATER_PARTICIPATION_RELEASES: `${id}:${row.payload_hash}` } };
+    expect((await loadRosterObservationSkaterParticipation(db as never, 20262027, new Date(issuance.issuedAt), options)).sources[0])
+      .toMatchObject({ probability: 2 / 3, basis: "appearance", model: { version: "skater-roster-observation-appearance-frequency-v1" } });
+    row.payload.entries[0].input.targetRosterObservation!.knownConflict = true;
+    row.payload_hash = playerForecastSourcePayloadHash(row.payload);
+    expect((await loadRosterObservationSkaterParticipation(db as never, 20262027, new Date(issuance.issuedAt),
+      { environment: { PLAYER_FORECAST_ROSTER_OBSERVATION_SKATER_PARTICIPATION_RELEASES: `${id}:${row.payload_hash}` } })).sources).toEqual([]);
+  });

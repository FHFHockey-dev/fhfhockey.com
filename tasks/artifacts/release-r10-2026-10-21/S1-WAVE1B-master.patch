+    : mode === "roster_start" ? ROSTER_OBSERVATION_GOALIE_START_DATASET
+    : mode === "roster_appearance" ? ROSTER_OBSERVATION_GOALIE_PARTICIPATION_DATASET
+    : mode === "frozen_start" ? FROZEN_WINDOW_GOALIE_START_DATASET

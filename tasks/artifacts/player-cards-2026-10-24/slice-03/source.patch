+.flowControls :is(input,select,button) { box-sizing: border-box; width: 100%; min-height: 44px; color: v.$color-brand-white; background: v.$color-neutral-900; border: 1px solid v.$color-neutral-400; border-radius: 7px; padding: 9px; font: inherit; }
+.flowControls button { margin-top: 10px; cursor: pointer; }
+.flowControls button:hover { background: v.$color-neutral-800; }
+.flowControls :is(input,select,button):focus-visible, .flowReadings summary:focus-visible { outline: 3px solid v.$color-gold-400; outline-offset: 3px; }

+// @vitest-environment node
+import { EventEmitter } from "node:events";
+import { inspect } from "node:util";
+import puppeteerPackage from "puppeteer-core/package.json";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { webhookErrorDiagnostic } from "./webhookErrorDiagnostic";
+
+const mocks = vi.hoisted(() => ({ WebSocket: vi.fn() }));
+vi.mock("ws", () => ({ default: mocks.WebSocket }));
+
+import { createBrowserlessTransport } from "./browserlessTransport";
+
+const endpoint = "wss://browserless.invalid/chromium?token=fixture_secret&launch=fixture_options";
+
+class FixtureSocket extends EventEmitter {
+  send = vi.fn((_message: string, callback: (error?: Error) => void) => callback());
+  terminate = vi.fn(() => { this.emit("close"); });
+}
+
+function unsafeError(code = "ECONNRESET") {
+  return Object.assign(new Error(`${code} ${endpoint}`), {
+    code, url: endpoint, target: { _url: endpoint },
+    headers: { Authorization: "Bearer fixture_secret" },
+    cause: { message: encodeURIComponent(endpoint), stack: endpoint }
+  });
+}
+
+function expectSafe(error: unknown) {
+  expect(error).toBeInstanceOf(Error);
+  for (const output of [inspect(error), JSON.stringify(error)]) {
+    expect(output).not.toContain("fixture_");
+    expect(output).not.toContain("browserless.invalid");
+    expect(output).not.toContain(endpoint);
+  }
+}
+
+describe("Browserless encrypted transport", () => {
+  let socket: FixtureSocket;
+
+  beforeEach(() => {
+    vi.resetAllMocks();
+    vi.useFakeTimers();
+    socket = new FixtureSocket();
+    mocks.WebSocket.mockImplementation(function () { return socket; });
+  });
+
+  afterEach(() => {
+    vi.useRealTimers();
+    vi.unstubAllEnvs();
+  });
+
+  it.each([
+    undefined, "", "fixture_secret", "ws://browserless.invalid?token=fixture_secret",
+    "https://browserless.invalid?token=fixture_secret", "http://browserless.invalid",
+    "wss://fixture_user:fixture_password@browserless.invalid",
+    "wss://@browserless.invalid", `${endpoint}#fixture_fragment`, `${endpoint}#`,
+    ` ${endpoint}`, `${endpoint}\n`, "wss:\\browserless.invalid",
+    "wss:browserless.invalid", "wss:///browserless.invalid", "wss://[invalid"
+  ])("rejects invalid/insecure configuration before allocating a socket (%#)", async (value) => {
+    const error = await createBrowserlessTransport(value).catch((error: unknown) => error);
+    expectSafe(error);
+    expect(webhookErrorDiagnostic(error)).toEqual({ name: "Error", reason: "endpoint_invalid_or_insecure" });
+    expect(mocks.WebSocket).not.toHaveBeenCalled();
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it("keeps the configured path/query and requires verified TLS with no redirects", async () => {
+    vi.stubEnv("NODE_TLS_REJECT_UNAUTHORIZED", "0");
+    const pending = createBrowserlessTransport(endpoint);
+    expect(mocks.WebSocket).toHaveBeenCalledTimes(1);
+    const [url, options] = mocks.WebSocket.mock.calls[0];
+    expect(url.toString()).toBe(endpoint);
+    expect(options).toEqual({
+      followRedirects: false, rejectUnauthorized: true, allowSynchronousEvents: false,
+      perMessageDeflate: false,
+      maxPayload: 256 * 1024 * 1024, handshakeTimeout: 10_000,
+      headers: { "User-Agent": `Puppeteer ${puppeteerPackage.version}` }
+    });
+    socket.emit("open");
+    const transport = await pending;
+    expect(vi.getTimerCount()).toBe(0);
+    expect(inspect(transport)).not.toContain("fixture_secret");
+    transport.close();
+  });
+
+  it.each([
+    "ERR_TLS_CERT_ALTNAME_INVALID", "CERT_HAS_EXPIRED",
+    "DEPTH_ZERO_SELF_SIGNED_CERT", "UNABLE_TO_VERIFY_LEAF_SIGNATURE"
+  ])("sanitizes %s and terminates without retry or insecure fallback", async (code) => {
+    const result = createBrowserlessTransport(endpoint).catch((error: unknown) => error);
+    socket.emit("error", unsafeError(code));
+    const error = await result;
+    expectSafe(error);
+    expect(webhookErrorDiagnostic(error)).toMatchObject({
+      name: "Error", reason: "browser_transport_failed", cause: { code }
+    });
+    expect(socket.terminate).toHaveBeenCalledTimes(1);
+    expect(mocks.WebSocket).toHaveBeenCalledTimes(1);
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it.each([301, 302, 303, 307, 308, 401, 403])("rejects HTTP %s without following Location or exposing the response", async (statusCode) => {
+    const result = createBrowserlessTransport(endpoint).catch((error: unknown) => error);
+    socket.emit("unexpected-response", { url: endpoint }, {
+      statusCode, headers: { location: "ws://downgrade.invalid/?token=fixture_secret" },
+      body: endpoint
+    });
+    const error = await result;
+    expectSafe(error);
+    expect(webhookErrorDiagnostic(error)).toMatchObject({
+      reason: "browser_transport_failed",
+      cause: statusCode >= 400 ? { status: statusCode } : { name: "UnknownError" }
+    });
+    expect(mocks.WebSocket).toHaveBeenCalledTimes(1);
+    expect(socket.terminate).toHaveBeenCalledTimes(1);
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it("bounds the entire handshake, including a stalled DNS lookup and a late open", async () => {
+    const resolved = vi.fn();
+    const result = createBrowserlessTransport(endpoint).then(resolved, (error: unknown) => error);
+    await vi.advanceTimersByTimeAsync(10_000);
+    const error = await result;
+    expectSafe(error);
+    expect(webhookErrorDiagnostic(error)).toMatchObject({ cause: { code: "ETIMEDOUT" } });
+    socket.emit("open");
+    expect(resolved).not.toHaveBeenCalled();
+    expect(socket.terminate).toHaveBeenCalledTimes(1);
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it("sanitizes synchronous constructor errors and clears its deadline", async () => {
+    mocks.WebSocket.mockImplementation(() => { throw unsafeError(); });
+    const error = await createBrowserlessTransport(endpoint).catch((error: unknown) => error);
+    expectSafe(error);
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it("rejects an early socket close instead of leaving the connection pending", async () => {
+    const result = createBrowserlessTransport(endpoint).catch((error: unknown) => error);
+    socket.emit("close");
+    expectSafe(await result);
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it("forwards CDP messages and closes idempotently without exposing a socket", async () => {
+    const pending = createBrowserlessTransport(endpoint);
+    socket.emit("open");
+    const transport = await pending;
+    transport.onmessage = vi.fn();
+    transport.onclose = vi.fn();
+    socket.emit("message", Buffer.from('{"id":1,"result":{}}'));
+    expect(transport.onmessage).toHaveBeenCalledWith('{"id":1,"result":{}}');
+    transport.send('{"id":1,"method":"Browser.getVersion"}');
+    expect(socket.send).toHaveBeenCalledWith('{"id":1,"method":"Browser.getVersion"}', expect.any(Function));
+    transport.close();
+    transport.close();
+    socket.emit("error", unsafeError());
+    socket.emit("message", Buffer.from("late message"));
+    expect(transport.onmessage).toHaveBeenCalledTimes(1);
+    expect(transport.onclose).toHaveBeenCalledExactlyOnceWith();
+    expect(socket.terminate).toHaveBeenCalledTimes(1);
+    expectSafe((() => { try { transport.send("late"); } catch (error) { return error; } })());
+  });
+
+  it.each(["event", "send", "callback"])("closes on an established connection's %s error without exposing it", async (mode) => {
+    const pending = createBrowserlessTransport(endpoint);
+    socket.emit("open");
+    const transport = await pending;
+    transport.onclose = vi.fn();
+    if (mode === "event") socket.emit("error", unsafeError());
+    if (mode === "callback") {
+      socket.send.mockImplementation((_message, callback) => callback(unsafeError()));
+      transport.send("fixture CDP message");
+    }
+    if (mode === "send") {
+      socket.send.mockImplementation(() => { throw unsafeError(); });
+      expectSafe((() => { try { transport.send("fixture CDP message"); } catch (error) { return error; } })());
+    }
+    expect(socket.terminate).toHaveBeenCalledTimes(1);
+    expect(transport.onclose).toHaveBeenCalledExactlyOnceWith();
+    expect(vi.getTimerCount()).toBe(0);
+  });
+});

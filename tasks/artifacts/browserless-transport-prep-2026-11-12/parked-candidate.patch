+import type { ConnectionTransport } from "puppeteer-core";
+import puppeteerPackage from "puppeteer-core/package.json";
+import WebSocket from "ws";
+import { webhookErrorDiagnostic } from "./webhookErrorDiagnostic";
+
+const CONNECT_TIMEOUT_MS = 10_000;
+
+function connectionError(cause?: unknown): Error {
+  return Object.assign(new Error("Browserless transport connection failed."), {
+    cause: webhookErrorDiagnostic(cause)
+  });
+}
+
+export async function createBrowserlessTransport(
+  endpoint: string | undefined
+): Promise<ConnectionTransport> {
+  // The URL is server-owned configuration. Do not include it in errors, even
+  // when URL parsing fails: it may carry the Browserless credential.
+  let url: URL;
+  try {
+    if (!endpoint || /[\u0000-\u0020\u007f\\]/.test(endpoint)) throw new Error();
+    url = new URL(endpoint);
+    if (
+      url.protocol !== "wss:" || !url.hostname || url.username || url.password ||
+      endpoint.includes("#") || !/^wss:\/\/[^/?#]+(?:[/?#]|$)/i.test(endpoint) ||
+      /^wss:\/\/[^/?#]*@/i.test(endpoint)
+    ) throw new Error();
+  } catch {
+    throw new Error("PUPPETEER_ENDPOINT is invalid or insecure.");
+  }
+
+  return new Promise<ConnectionTransport>((resolve, reject) => {
+    let socket: WebSocket | undefined;
+    let state: "connecting" | "open" | "closed" = "connecting";
+    const timer = setTimeout(() => close({ code: "ETIMEDOUT" }), CONNECT_TIMEOUT_MS);
+    const transport: ConnectionTransport = {
+      send(message) {
+        if (state !== "open" || !socket) throw connectionError();
+        try {
+          socket.send(message, (error) => { if (error) close(error); });
+        } catch (error: unknown) {
+          close(error);
+          throw connectionError(error);
+        }
+      },
+      close: () => close()
+    };
+
+    function close(error?: unknown) {
+      if (state === "closed") return;
+      const wasConnecting = state === "connecting";
+      state = "closed";
+      clearTimeout(timer);
+      if (wasConnecting) reject(connectionError(error));
+      // Bound cleanup rather than waiting for a peer's close-handshake. Never
+      // expose an error object from ws, whose fields can contain the full URL.
+      try { socket?.terminate(); } catch { /* Already unusable. */ }
+      if (!wasConnecting) transport.onclose?.();
+    }
+
+    try {
+      // Match Puppeteer's message scheduling; installed ws supports this option
+      // although the current @types/ws version does not yet declare it.
+      const options: WebSocket.ClientOptions & { allowSynchronousEvents: boolean } = {
+        followRedirects: false,
+        rejectUnauthorized: true,
+        allowSynchronousEvents: false,
+        perMessageDeflate: false,
+        maxPayload: 256 * 1024 * 1024,
+        handshakeTimeout: CONNECT_TIMEOUT_MS,
+        headers: { "User-Agent": `Puppeteer ${puppeteerPackage.version}` }
+      };
+      socket = new WebSocket(url, options);
+      socket.on("error", close);
+      socket.on("unexpected-response", (_request, response) => {
+        close({ status: response.statusCode });
+      });
+      socket.on("close", () => close());
+      socket.on("message", (data) => {
+        if (state === "open") transport.onmessage?.(data.toString());
+      });
+      socket.on("open", () => {
+        if (state !== "connecting") return;
+        state = "open";
+        clearTimeout(timer);
+        resolve(transport);
+      });
+    } catch (error: unknown) {
+      close(error);
+    }
+  });
+}

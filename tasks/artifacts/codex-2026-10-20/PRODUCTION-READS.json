    {
      "name": "Sustainability remaining degraded keys",
      "query": "BEGIN READ ONLY;\nSET LOCAL statement_timeout='10s';\nWITH degraded AS (\nSELECT DISTINCT s.snapshot_date,s.player_id,s.window_code,regexp_replace(w.warning,'^missing_window_z_','') AS stat_code\nFROM public.sustainability_scores s CROSS JOIN LATERAL jsonb_array_elements_text(CASE WHEN jsonb_typeof(s.components->'warnings')='array' THEN s.components->'warnings' ELSE '[]'::jsonb END) w(warning)\nWHERE s.snapshot_date>=date '2026-10-13' AND s.snapshot_date<date '2026-10-21' AND w.warning LIKE 'missing\\_window\\_z\\_%' ESCAPE '\\')\nSELECT snapshot_date,count(*) AS missing_stat_keys,count(*) FILTER(WHERE EXISTS(\nSELECT 1 FROM public.sustainability_window_z z WHERE z.snapshot_date=d.snapshot_date AND z.player_id=d.player_id AND z.window_code=d.window_code AND z.stat_code=d.stat_code)) AS now_repairable_stat_keys\nFROM degraded d GROUP BY snapshot_date ORDER BY snapshot_date;\nROLLBACK;",
      "rows": []
    },
    {
      "name": "Sweep summary marker freshness",
      "query": "BEGIN READ ONLY;\nSET LOCAL statement_timeout='10s';\nWITH status AS (SELECT game_id,game_date,status,completed_at FROM public.nhl_api_game_normalization_status WHERE game_date>=date '2026-09-19' AND game_date<date '2026-10-21'),\nmarked AS (SELECT s.*,(SELECT max(p.fetched_at) FROM public.nhl_api_game_payloads_raw p WHERE p.game_id=s.game_id AND p.endpoint='landing' AND p.source_url='derived://underlying-player-summary-v2/individual/allStrengths/'||s.game_id::text) AS summary_marker_at FROM status s)\nSELECT game_date,count(*) AS games,count(*) FILTER(WHERE status IS DISTINCT FROM 'complete') AS normalization_incomplete,count(*) FILTER(WHERE status='complete' AND (summary_marker_at IS NULL OR completed_at IS NULL OR summary_marker_at<completed_at)) AS summary_marker_missing_or_stale\nFROM marked GROUP BY game_date ORDER BY game_date;\nROLLBACK;",

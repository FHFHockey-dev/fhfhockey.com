      "name": "NST date coverage",
      "query": "BEGIN READ ONLY;\nSET LOCAL statement_timeout = '10s';\nWITH calendar AS (SELECT generate_series(date '2026-09-28', date '2026-10-18', interval '1 day')::date AS date),\nscheduled AS (SELECT DISTINCT date::date AS date FROM public.games WHERE \"seasonId\"=20262027 AND type=2 AND date>=date '2026-09-28' AND date<date '2026-10-19'),\nnst AS (SELECT 'nst_team_gamelogs_as_counts' AS source,date::date AS date,count(*) AS row_count,count(DISTINCT team_abbreviation) AS team_count FROM public.nst_team_gamelogs_as_counts WHERE date>=date '2026-09-28' AND date<date '2026-10-19' GROUP BY date::date\nUNION ALL\nSELECT 'nst_team_gamelogs_as_rates' AS source,date::date AS date,count(*) AS row_count,count(DISTINCT team_abbreviation) AS team_count FROM public.nst_team_gamelogs_as_rates WHERE date>=date '2026-09-28' AND date<date '2026-10-19' GROUP BY date::date\nUNION ALL\nSELECT 'nst_team_gamelogs_es_counts' AS source,date::date AS date,count(*) AS row_count,count(DISTINCT team_abbreviation) AS team_count FROM public.nst_team_gamelogs_es_counts WHERE date>=date '2026-09-28' AND date<date '2026-10-19' GROUP BY date::date\nUNION ALL\nSELECT 'nst_team_gamelogs_es_rates' AS source,date::date AS date,count(*) AS row_count,count(DISTINCT team_abbreviation) AS team_count FROM public.nst_team_gamelogs_es_rates WHERE date>=date '2026-09-28' AND date<date '2026-10-19' GROUP BY date::date\nUNION ALL\nSELECT 'nst_team_gamelogs_pp_counts' AS source,date::date AS date,count(*) AS row_count,count(DISTINCT team_abbreviation) AS team_count FROM public.nst_team_gamelogs_pp_counts WHERE date>=date '2026-09-28' AND date<date '2026-10-19' GROUP BY date::date\nUNION ALL\nSELECT 'nst_team_gamelogs_pp_rates' AS source,date::date AS date,count(*) AS row_count,count(DISTINCT team_abbreviation) AS team_count FROM public.nst_team_gamelogs_pp_rates WHERE date>=date '2026-09-28' AND date<date '2026-10-19' GROUP BY date::date\nUNION ALL\nSELECT 'nst_team_gamelogs_pk_counts' AS source,date::date AS date,count(*) AS row_count,count(DISTINCT team_abbreviation) AS team_count FROM public.nst_team_gamelogs_pk_counts WHERE date>=date '2026-09-28' AND date<date '2026-10-19' GROUP BY date::date\nUNION ALL\nSELECT 'nst_team_gamelogs_pk_rates' AS source,date::date AS date,count(*) AS row_count,count(DISTINCT team_abbreviation) AS team_count FROM public.nst_team_gamelogs_pk_rates WHERE date>=date '2026-09-28' AND date<date '2026-10-19' GROUP BY date::date)\nSELECT c.date,(s.date IS NOT NULL) AS has_regular_season_game,sources.source,coalesce(n.row_count,0) AS row_count,coalesce(n.team_count,0) AS team_count\nFROM calendar c LEFT JOIN scheduled s USING(date) CROSS JOIN (VALUES ('nst_team_gamelogs_as_counts'),('nst_team_gamelogs_as_rates'),('nst_team_gamelogs_es_counts'),('nst_team_gamelogs_es_rates'),('nst_team_gamelogs_pp_counts'),('nst_team_gamelogs_pp_rates'),('nst_team_gamelogs_pk_counts'),('nst_team_gamelogs_pk_rates')) AS sources(source) LEFT JOIN nst n ON n.date=c.date AND n.source=sources.source ORDER BY c.date,sources.source;\nROLLBACK;",

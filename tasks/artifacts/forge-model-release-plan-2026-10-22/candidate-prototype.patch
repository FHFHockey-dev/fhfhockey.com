+vi.mock("lib/supabase/server", () => {
+  const rows = [
+    { game_date: "2025-12-01", shots_against: 30, goals_allowed: 3 },
+    { game_date: "2026-10-10", shots_against: 28, goals_allowed: 2 },
+  ];
+  const builder: any = {

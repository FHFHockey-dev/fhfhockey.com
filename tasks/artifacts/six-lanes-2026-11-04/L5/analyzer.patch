+.page {
+  display: grid;
+  gap: 24px;
+  max-width: 1400px;
+  margin: 0 auto;
+  padding-block: 28px 48px;
+  color: #eef8fb;
+  font-variant-numeric: tabular-nums;
+  h1, h2, h3, h4, p { margin: 0; }
+  h1 { margin-block: 8px 12px; font-size: clamp(2rem, 4vw, 3rem); }
+  h2 { font-size: 1.25rem; }
+  h3 { font-size: 1.15rem; }
+  h4 { margin-top: 16px; font-size: 1rem; }
+  p, li { line-height: 1.5; overflow-wrap: anywhere; }
+  form, fieldset, .results { display: grid; gap: 16px; min-width: 0; }
+  label { display: grid; gap: 8px; font-size: 0.9rem; font-weight: 600; }
+  input, textarea, button { font: inherit; min-height: 44px; }
+  input:not([type="checkbox"]), textarea { width: 100%; box-sizing: border-box; min-width: 0; padding: 10px 12px;
+    border: 1px solid #58717e; border-radius: 6px; background: #09151d; color: #f3fbff; }
+  textarea { resize: vertical; }
+  textarea::placeholder { color: #91a9b5; }
+  :is(input, textarea, button):focus-visible { outline: 3px solid #75dafa; outline-offset: 2px; }
+  ul { margin-block: 8px; padding-inline-start: 20px; }
+}
+.hero, .panel { min-width: 0; padding: 24px; border: 1px solid #304551; border-radius: 14px; background: #101d26; }
+.panel { margin: 0; }
+.panel legend { padding-inline: 8px; font-size: 1.25rem; font-weight: 700; }
+.hero { background: linear-gradient(120deg, #102b38, #101d26 70%); }
+.eyebrow { color: #74d5f2; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
+.note { margin-top: 8px !important; color: #b7c8d1; font-size: 0.85rem; }
+.teamGrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: 24px; align-items: start; }
+.page .check { display: flex; align-items: center; gap: 10px; min-height: 44px; line-height: 1.4; }
+.check input { flex: 0 0 auto; width: 20px; height: 20px; min-height: 20px; accent-color: #6bd4f6; }
+.page .selectionList { display: grid; gap: 4px; padding: 0; margin: 0; list-style: none; }
+.previewButton { justify-self: start; padding: 12px 20px; border: 1px solid #4d798c; border-radius: 7px; background: #183544; color: #effbff; font-weight: 700; cursor: pointer; }
+.previewButton:hover { background: #224b5e; }
+.date { max-width: 300px; }
+.warning { padding: 12px; border: 1px solid #8d6d37; border-radius: 9px; background: #302718; color: #ffe0a5; }
+.capacity { margin-top: 16px !important; padding: 12px; background: #183544; border-radius: 7px; }
+.results > .panel { display: grid; gap: 12px; }
+@media (max-width: 600px) {
+  .hero, .panel { padding: 16px; }
+}

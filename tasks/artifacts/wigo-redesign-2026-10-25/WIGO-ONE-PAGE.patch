+// lets the page scroll (769–1199px, or short viewports). Nothing scrolls or clips inside a panel in either mode.
+@function wigo-areas($spans...) {
+  $row: "";
+  @each $name, $count in $spans {
+    @for $i from 1 through $count {
+      $row: $row + $name + " ";
+    }
+  }
+  @return $row;
+}
+
+:global(.wigo-one-page) {
+  &.wigoDashHeader {
+    --wigo-data-size: 11px;
+    --wigo-emphasis-size: 15px;
+  }

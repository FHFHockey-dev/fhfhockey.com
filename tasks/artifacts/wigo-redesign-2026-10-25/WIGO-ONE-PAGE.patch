+    grid-template-areas:
+      "#{wigo-areas(context 24)}"
+      "#{wigo-areas(identity 5, pace 5, sched 4, ratings 4, drivers 6)}"
+      "#{wigo-areas(prod 5, pace 5, sched 4, ratings 4, drivers 6)}"
+      "#{wigo-areas(matrix 18, consist 6)}"
+      "#{wigo-areas(matrix 18, radar 6)}"
+      "#{wigo-areas(selected 5, toi 4, ppg 4, gs 4, pct 7)}";
+  }
+  .identitySummary,
+  .opponentLogContainer,
+  .ratingsContainer,
+  .teamDriversSummary,
+  .consistencyRatingContainer,
+  .percentileChartContainer,
+  .comparisonMatrixPanel,
+  .selectedStatPanel,
+  .rateStatBarPercentilesContainer,
+  .toiChartContainer,
+  .ppgChartContainer,
+  .gameScoreContainer {
+    overflow: hidden;
+  }
+  .comparisonMatrixPanel {
+    display: flex;
+    flex-direction: column;
+    container-type: inline-size;
+  }
+  .matrixToolbar {
+    height: auto;
+    min-height: 28px;
+    gap: 10px;
+    padding: 2px 8px;
+    font-size: 11px;
+    > div {
+      width: 300px;
+    }
+  }
+  // The identity card carries the page's one team-colour accent: a filled top rail, never a border fragment.
+  .identitySummary {
+    position: relative;
+    &::before {
+      content: "";
+      position: absolute;
+      inset: 0 0 auto;
+      height: 3px;
+      border-radius: v.$radius-sm v.$radius-sm 0 0;
+      background: var(--primary-color, #{v.$primary-color});
+      pointer-events: none;
+    }
   }
 }
+
+:global(.wigo-one-page.wigo-fit) {
+  .wigoDashboardContent {
+    height: calc(var(--wigo-fit-height) - 4px);
+    grid-template-rows:

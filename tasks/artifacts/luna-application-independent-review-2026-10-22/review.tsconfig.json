{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "components/*": [
        "./components/*"
      ],
      "contexts/*": [
        "./contexts/*"
      ],
      "hooks/*": [
        "./hooks/*"
      ],
      "lib/*": [
        "./lib/*"
      ],
      "next-seo.config": [
        "./next-seo.config.js"
      ],
      "pages/*": [
        "./pages/*"
      ],
      "public/*": [
        "./public/*"
      ],
      "styles/*": [
        "./styles/*"
      ],
      "utils/*": [
        "./utils/*"
      ]
    },
    "resolvePackageJsonExports": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "lib/sources/playerIdentitySnapshotEvidence.ts",
    "lib/sources/playerIdentitySnapshotEvidence.test.ts",
    "lib/sources/tweetIdentityReplacementReview.ts",
    "lib/sources/tweetIdentityReplacementReview.test.ts"
  ],
  "exclude": []
}

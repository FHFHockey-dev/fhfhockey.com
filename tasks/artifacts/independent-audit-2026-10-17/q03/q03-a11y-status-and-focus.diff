@@ -0,0 +1,25 @@
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { Header } from "pages/lines/[abbreviation]";
+
+afterEach(cleanup);
+
+describe("team lines header", () => {
+  it("offers the logo image download as a named keyboard-reachable button", () => {
+    const onTeamLogoClick = vi.fn();
+    render(
+      <Header
+        teamName="Florida Panthers"
+        teamAbbreviation="FLA"
+        lastUpdated="2026-10-17T12:00:00.000Z"
+        sourceUrl="https://example.invalid/source"
+        onTeamLogoClick={onTeamLogoClick}
+      />,
+    );
+
+    const button = screen.getByRole("button", { name: "Download Florida Panthers line combinations image" });
+    expect(button.getAttribute("type")).toBe("button");
+    fireEvent.click(button);
+    expect(onTeamLogoClick).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/web/__tests__/styles/globalFocus.test.ts b/web/__tests__/styles/globalFocus.test.ts
new file mode 100644
index 000000000..9117baf33
--- /dev/null
+++ b/web/__tests__/styles/globalFocus.test.ts
@@ -0,0 +1,16 @@
+import fs from "fs";
+import path from "path";
+import { describe, expect, it } from "vitest";
+
+const css = fs.readFileSync(path.join(__dirname, "../../styles/globals.css"), "utf8");
+
+describe("global input focus", () => {
+  it("only hides the outline for pointer focus", () => {
+    expect(css).not.toMatch(/textarea:focus,\s*input:focus\s*{\s*outline:\s*none/);
+    expect(css).toMatch(/input:focus:not\(:focus-visible\)\s*{\s*outline:\s*none/);
+  });
+
+  it("keeps keyboard focus visible with the design focus color", () => {
+    expect(css).toMatch(/input:focus-visible\s*{\s*outline:\s*3px solid rgb\(255, 193, 8\)/);
+  });
+});

index 0000000000000000000000000000000000000000..d92b07246aa736ec8e1eaa57c6b3223de1af6940
--- /dev/null
+++ b/web/scripts/blsh/readRequestContextV6.test.ts
@@ -0,0 +1,137 @@
+// @vitest-environment node
+import { createHash } from "node:crypto";
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, symlinkSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { buildRequestFromContextV1, REQUEST_CONTEXT_CAPTURE } from "../../lib/blsh/nativeCaptureV6/requestContext";
+import { REQUEST_CONTEXT_FILES } from "../../lib/blsh/nativeCaptureV6/requestContextStore";
+import { readRequestContextV6Export } from "./readRequestContextV6";
+
+const temps: string[] = [];
+afterEach(() => { for (const dir of temps.splice(0)) rmSync(dir, { recursive: true, force: true }); });
+const sourceDate = "2026-11-19", runId = "abcdefab-1234-4567-8abc-123456789abc", nativeRunId = "12345678-1234-4567-8abc-123456789abc";
+const nativeManifestSHA256 = "9".repeat(64), deploymentId = "dpl_test", gitCommitSha = "a".repeat(40);
+const identity = { runId, sourceDate, nativeRunId, nativeManifestSHA256 };
+const claimedAtUTC = "2026-11-20T12:39:59.999999+00:00", asOfUTC = "2026-11-20T12:40:05.000Z";
+const nativeRetrievedAtUTC = { individual: "2026-11-20T12:05:20.001Z", onIce: "2026-11-20T12:05:45.003Z" };
+const hash = (b: Buffer) => createHash("sha256").update(new Uint8Array(b)).digest("hex");
+const json = (v: unknown) => Buffer.from(JSON.stringify(v) + "\n");
+type Change = { file?: (file: string, b: Buffer) => Buffer; result?: Record<string, unknown>; manifest?: Record<string, unknown> };
+
+function fixture(change: Change = {}) {
+  const dir = mkdtempSync(join(tmpdir(), "context-v6-readback-"));
+  temps.push(dir);
+  const prefix = ["request-context-v1", sourceDate, runId].join("/");
+  const fileDir = join(dir, "objects", prefix);
+  mkdirSync(fileDir, { recursive: true });
+  const db = readFileSync(join(__dirname, "../../lib/blsh/nativeCaptureV6/__fixtures__/request-context-v1.sample.json"));
+  const context = JSON.parse(db.toString());
+  const projected = buildRequestFromContextV1(context, { capturedAtUTC: asOfUTC });
+  const files: Record<string, Buffer> = { "DB-CONTEXT.json": db, ...projected.rawFiles, "CURRENT-REQUEST.json": json(projected.request) };
+  const records: { file: string; bytes: number; sha256: string }[] = [];
+  function emit(file: string, original: Buffer) {
+    const b = change.file?.(file, original) ?? original;
+    writeFileSync(join(fileDir, file), new Uint8Array(b));
+    records.push({ file, bytes: b.length, sha256: hash(b) });
+  }
+  for (const file of REQUEST_CONTEXT_FILES.slice(0, 6)) emit(file, files[file]);
+  emit("RESULT.json", json({ version: "fhfh.blsh.request-context-result.v1", state: "CAPTURED_READ_ONLY_UNQUALIFIED", ...identity,
+    requestDeployment: { deploymentId, gitCommitSha }, executionMode: REQUEST_CONTEXT_CAPTURE, captureContext: REQUEST_CONTEXT_CAPTURE,
+    atomicDatabaseSnapshot: true, sessionClosed: true, dateFrom: context.dateFrom, eventThroughDate: sourceDate,
+    snapshotUTC: context.snapshotUTC, statementUTC: context.statementUTC, nativeRetrievedAtUTC, asOfUTC, rows: projected.rows,
+    independentlyAccepted: false, advancedAdmission: false, score: null, artifacts: Object.fromEntries(records.map(r => [r.file, r.sha256])), ...change.result }));
+  emit("MANIFEST.json", json({ version: "fhfh.blsh.request-context-manifest.v1", ...identity, files: records, ...change.manifest }));
+  const pins = { ...identity, manifestSHA256: records[7].sha256, deploymentId, gitCommitSha };
+  const run = { run_id: runId, source_date: sourceDate, native_run_id: nativeRunId, native_manifest_sha256: nativeManifestSHA256,
+    state: "packet_complete_pending_review", reason: null, claimed_at: claimedAtUTC, closed_at: "2026-11-20T12:40:05.000009+00:00",
+    manifest_sha256: pins.manifestSHA256 };
+  const rows = records.map((r, i) => ({ ordinal: i + 1, path: prefix + "/" + r.file, bytes: r.bytes, sha256: r.sha256, run_id: runId,
+    written_at: "2026-11-20T12:40:05.00000" + (i + 1) + "+00:00" }));
+  function metadata() {
+    writeFileSync(join(dir, "run.json"), JSON.stringify(run));
+    writeFileSync(join(dir, "objects.json"), JSON.stringify(rows));
+  }
+  metadata();
+  return { dir, fileDir, pins, rows, run, metadata, read: () => readRequestContextV6Export(dir, pins) };
+}
+
+describe("request context export readback", () => {
+  it("preserves both original metadata buffers and exactly eight verified bodies", () => {
+    const f = fixture();
+    f.rows.reverse();
+    f.metadata();
+    const result = f.read();
+    expect([...result.files.keys()]).toEqual(REQUEST_CONTEXT_FILES);
+    expect(result.receipt).toMatchObject({ ...f.pins, asOfUTC, claimedAtUTC, nativeRetrievedAtUTC,
+      status: "request_context_readback_pending_review", independentlyAccepted: false, advancedAdmission: false, score: null });
+    expect(result.runBytes.toString()).toBe(JSON.stringify(f.run));
+    expect(result.objectRowsBytes.toString()).toBe(JSON.stringify(f.rows));
+    writeFileSync(join(f.fileDir, "CURRENT-REQUEST.json"), "replaced after verification");
+    expect(JSON.parse(result.files.get("CURRENT-REQUEST.json")!.toString()).asOfUTC).toBe(asOfUTC);
+  });
+  it.each([{ runId: nativeRunId }, { nativeRunId: runId }, { sourceDate: "2026-11-20" }, { manifestSHA256: "c".repeat(64) },
+    { nativeManifestSHA256: "d".repeat(64) }, { deploymentId: "dpl_other" }, { gitCommitSha: "b".repeat(40) }])("binds external pins %j", p => {
+    const f = fixture();
+    expect(() => readRequestContextV6Export(f.dir, { ...f.pins, ...p })).toThrow();
+  });
+  it.each(["claimed", "failed"])("refuses a %s run even with a complete manifest", state => {
+    const f = fixture();
+    f.run.state = state;
+    f.metadata();
+    expect(f.read).toThrow("context_run_mismatch");
+  });
+  it("refuses a successful ledger that spans more than one invocation", () => {
+    const f = fixture();
+    f.run.closed_at = "2026-11-20T12:44:00.000000Z";
+    f.metadata();
+    expect(f.read).toThrow("context_clock_mismatch");
+  });
+  it.each(["missing", "ordinal", "cross-run", "path", "early", "late", "reordered", "per-file-limit", "aggregate-limit"])("checks %s index input", kind => {
+    const f = fixture();
+    if (kind === "missing") f.rows.pop();
+    if (kind === "ordinal") f.rows[7].ordinal = 7;
+    if (kind === "cross-run") f.rows[2].run_id = nativeRunId;
+    if (kind === "path") f.rows[2].path += "/../DB-CONTEXT.json";
+    if (kind === "early") f.rows[0].written_at = "2026-11-20T12:39:59.999998Z";
+    if (kind === "late") f.rows[7].written_at = "2026-11-20T12:40:05.000010Z";
+    if (kind === "reordered") f.rows[1].written_at = "2026-11-20T12:40:05.000000Z";
+    if (kind === "per-file-limit") f.rows[0].bytes = 8 * 1024 * 1024 + 1;
+    if (kind === "aggregate-limit") f.rows.slice(1, 5).forEach(r => { r.bytes = 16 * 1024 * 1024; });
+    f.metadata();
+    expect(f.read).toThrow(/context_(index|clock|export_file_size|packet_size)/);
+  });
+  it("detects same-length body changes and symlink substitution", () => {
+    const f = fixture(), p = join(f.fileDir, "RAW-wgo.json"), bytes = readFileSync(p);
+    const changed = Buffer.from(new Uint8Array(bytes));
+    changed[0] ^= 1;
+    writeFileSync(p, new Uint8Array(changed));
+    expect(f.read).toThrow("context_object_digest_mismatch");
+    rmSync(p);
+    writeFileSync(join(f.dir, "other"), new Uint8Array(bytes));
+    symlinkSync(join(f.dir, "other"), p);
+    expect(f.read).toThrow("context_export_path_mismatch");
+  });
+  it.each([{ advancedAdmission: true }, { independentlyAccepted: true }, { score: 0 }, { rows: {} }, { artifacts: {} },
+    { snapshotUTC: asOfUTC }, { eventThroughDate: "2026-11-18" }, { atomicDatabaseSnapshot: false },
+    { nativeRetrievedAtUTC: { individual: "2026-11-20T00:40:04.999999Z", onIce: nativeRetrievedAtUTC.onIce } }])("rejects resealed RESULT %j", result => {
+    expect(fixture({ result }).read).toThrow(/context_(result|clock|scope)_mismatch/);
+  });
+  it("checks the exact DB snapshot against the SQL claim microsecond", () => {
+    const f = fixture();
+    f.run.claimed_at = "2026-11-20T12:40:00.000001Z";
+    f.metadata();
+    expect(f.read).toThrow("context_clock_mismatch");
+  });
+  it.each(["RAW-wgo.json", "RAW-individual.json", "RAW-onIce.json", "RAW-calendar.json", "CURRENT-REQUEST.json"])("reconstructs resealed %s", target => {
+    expect(fixture({ file: (file, b) => file === target ? json({ ...JSON.parse(b.toString()), unexpected: true }) : b }).read).toThrow("context_projection_mismatch");
+  });
+  it("rejects a separately resealed manifest that drops indexed descriptors", () => {
+    expect(fixture({ manifest: { files: [] } }).read).toThrow("context_manifest_mismatch");
+  });
+  it.each(["MANIFEST.json", "RESULT.json", "DB-CONTEXT.json"])("rejects duplicate or invalid UTF-8 in %s even if all hashes match", target => {
+    const duplicate = (b: Buffer) => Buffer.from(b.toString().replace("{", '{"version":1,'));
+    expect(fixture({ file: (file, b) => file === target ? duplicate(b) : b }).read).toThrow("duplicate_json_member");
+    expect(fixture({ file: (file, b) => file === target ? Buffer.from([0xff]) : b }).read).toThrow();
+  });
+});
diff --git a/web/scripts/blsh/readRequestContextV6.ts b/web/scripts/blsh/readRequestContextV6.ts
new file mode 100644
index 0000000000000000000000000000000000000000..01e54debc4df33193b4f9bbe386061290f352f90
--- /dev/null
+++ b/web/scripts/blsh/readRequestContextV6.ts
@@ -0,0 +1,120 @@
+/** Offline readback of the completed eight-object request/context export. */
+import { createHash } from "node:crypto";
+import { closeSync, constants, fstatSync, openSync, readSync, realpathSync } from "node:fs";
+import { join } from "node:path";
+import { isDeepStrictEqual } from "node:util";
+import { reviewedEvidenceTime } from "../../lib/buyLowSellHigh/reviewedFiveGameWindow.server";
+import { matches, need, object, parseJSON, timestamp } from "../../lib/blsh/nativeCaptureV6/packetFormat";
+import { buildRequestFromContextV1, REQUEST_CONTEXT_CAPTURE, type RequestContextResult } from "../../lib/blsh/nativeCaptureV6/requestContext";
+import { contextObjectLimit, REQUEST_CONTEXT_FILES, type NativeContextTarget } from "../../lib/blsh/nativeCaptureV6/requestContextStore";
+import { PILOT_FENCE_FIRST_CAPTURE_DATE, SEASON_FIRST_DATE, SEASON_LAST_DATE } from "../../lib/blsh/nativeCaptureV6/sourceDate";
+
+export type RequestContextV6Pins = NativeContextTarget & {
+  runId: string; manifestSHA256: string; deploymentId: string; gitCommitSha: string;
+};
+const UUID = /^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$/, SHA = /^[0-9a-f]{64}$/;
+const COMPLETE = "packet_complete_pending_review", DAY_MS = 86400000;
+const digest = (b: Buffer) => createHash("sha256").update(new Uint8Array(b.buffer, b.byteOffset, b.length)).digest("hex");
+const decode = (b: Buffer) => parseJSON(new Uint8Array(b.buffer, b.byteOffset, b.length));
+const json = (value: unknown) => Buffer.from(JSON.stringify(value) + "\n");
+const day = (ms: number) => new Date(ms).toISOString().slice(0, 10);
+function utc(value: unknown) {
+  need(typeof value === "string", "invalid_utc_time");
+  timestamp(value);
+  return value;
+}
+
+function localFile(root: string, name: string, limit: number, expected?: number) {
+  const path = join(root, name);
+  need(realpathSync(path) === path, "context_export_path_mismatch");
+  const fd = openSync(path, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
+  try {
+    const stat = fstatSync(fd);
+    need(stat.isFile() && stat.size > 0 && stat.size <= limit && (expected === undefined || expected === stat.size), "context_export_file_size");
+    const bytes = Buffer.alloc(stat.size);
+    const view = new Uint8Array(bytes.buffer, bytes.byteOffset, bytes.length);
+    for (let offset = 0; offset < bytes.length;) {
+      const n = readSync(fd, view, offset, bytes.length - offset, offset);
+      need(n > 0, "context_export_file_size");
+      offset += n;
+    }
+    need(fstatSync(fd).size === stat.size, "context_export_file_size");
+    return bytes;
+  } finally { closeSync(fd); }
+}
+
+export function readRequestContextV6Export(contextExportDir: string, pins: RequestContextV6Pins) {
+  const { sourceDate, nativeRunId, nativeManifestSHA256, runId, manifestSHA256, deploymentId, gitCommitSha } = pins;
+  need(matches(sourceDate, /^\d{4}-\d\d-\d\d$/), "context_date_invalid");
+  const sourceMs = Date.parse(sourceDate + "T00:00:00Z");
+  need(Number.isFinite(sourceMs) && day(sourceMs) === sourceDate && sourceDate >= SEASON_FIRST_DATE, "context_date_invalid");
+  const nextDay = day(sourceMs + DAY_MS), dateFrom = day(sourceMs - 28 * DAY_MS);
+  need(nextDay >= PILOT_FENCE_FIRST_CAPTURE_DATE && nextDay <= SEASON_LAST_DATE, "context_date_invalid");
+  need(matches(runId, UUID) && matches(nativeRunId, UUID) && matches(nativeManifestSHA256, SHA) && matches(manifestSHA256, SHA)
+    && matches(deploymentId, /^[A-Za-z0-9_-]{1,128}$/) && matches(gitCommitSha, /^[0-9a-f]{40}$/), "context_target_invalid");
+  const root = realpathSync(contextExportDir);
+  const runBytes = localFile(root, "run.json", 65536), objectRowsBytes = localFile(root, "objects.json", 65536);
+  const run = object(decode(runBytes)), rows = decode(objectRowsBytes);
+  need(run.state === COMPLETE && run.reason === null && run.run_id === runId && run.source_date === sourceDate
+    && run.native_run_id === nativeRunId && run.native_manifest_sha256 === nativeManifestSHA256 && run.manifest_sha256 === manifestSHA256,
+  "context_run_mismatch");
+  const claimedAtUTC = utc(run.claimed_at), closedAtUTC = utc(run.closed_at);
+  const claimed = timestamp(claimedAtUTC), closed = timestamp(closedAtUTC);
+  // Both ledger stamps come from PostgreSQL. One invocation has a 240-second hosted limit.
+  need(closed >= claimed && closed - claimed <= 240_000_000, "context_clock_mismatch");
+  need(Array.isArray(rows) && rows.length === REQUEST_CONTEXT_FILES.length, "context_index_count");
+  const sorted = rows.map(object).sort((a, b) => Number(a.ordinal) - Number(b.ordinal));
+  let prior = claimed, total = 0;
+  const records = REQUEST_CONTEXT_FILES.map((file, i) => {
+    const row = sorted[i], path = "request-context-v1/" + sourceDate + "/" + runId + "/" + file;
+    need(row.run_id === runId && row.ordinal === i + 1 && row.path === path && matches(row.sha256, SHA), "context_index_mismatch");
+    const size = row.bytes;
+    need(typeof size === "number" && Number.isSafeInteger(size) && size > 0 && size <= contextObjectLimit(file), "context_export_file_size");
+    total += size;
+    need(total <= 64 * 1024 * 1024, "context_packet_size");
+    const written = timestamp(row.written_at);
+    need(prior <= written && written <= closed, "context_clock_mismatch");
+    prior = written;
+    return { file, bytes: size, sha256: row.sha256 };
+  });
+  const files = new Map<string, Buffer>();
+  for (const [i, record] of records.entries()) {
+    const bytes = localFile(root, join("objects", sorted[i].path as string), contextObjectLimit(record.file), record.bytes);
+    need(digest(bytes) === record.sha256, "context_object_digest_mismatch");
+    files.set(record.file, bytes);
+  }
+  const identity = { runId, sourceDate, nativeRunId, nativeManifestSHA256 };
+  need(records[7].sha256 === manifestSHA256 && isDeepStrictEqual(decode(files.get("MANIFEST.json")!), {
+    version: "fhfh.blsh.request-context-manifest.v1", ...identity, files: records.slice(0, 7),
+  }), "context_manifest_mismatch");
+  const result = object(decode(files.get("RESULT.json")!));
+  const context = object(decode(files.get("DB-CONTEXT.json")!)) as unknown as RequestContextResult;
+  need(context.dateFrom === dateFrom && context.eventThroughDate === sourceDate && result.dateFrom === dateFrom
+    && result.eventThroughDate === sourceDate, "context_scope_mismatch");
+  const asOfUTC = utc(result.asOfUTC), observed = object(result.nativeRetrievedAtUTC);
+  const nativeRetrievedAtUTC = { individual: utc(observed.individual), onIce: utc(observed.onIce) };
+  const individual = timestamp(nativeRetrievedAtUTC.individual), onIce = timestamp(nativeRetrievedAtUTC.onIce);
+  // PostgreSQL serializes these two original clocks in the statement's session time zone.
+  const snapshot = reviewedEvidenceTime(context.snapshotUTC), statement = reviewedEvidenceTime(context.statementUTC);
+  const captured = timestamp(asOfUTC);
+  need(day(individual / 1000) === nextDay && day(claimed / 1000) === nextDay && individual <= onIce && onIce <= claimed
+    && claimed <= snapshot && snapshot <= statement && statement <= captured && captured <= timestamp(sorted[0].written_at)
+    && captured <= individual + 12 * 3600000000 && asOfUTC === new Date(captured / 1000).toISOString(), "context_clock_mismatch");
+  const projected = buildRequestFromContextV1(context, { capturedAtUTC: asOfUTC });
+  for (const [file, bytes] of [...Object.entries(projected.rawFiles), ["CURRENT-REQUEST.json", json(projected.request)] as const]) {
+    need(files.get(file)!.equals(new Uint8Array(bytes.buffer, bytes.byteOffset, bytes.length)), "context_projection_mismatch");
+  }
+  need(isDeepStrictEqual(result, {
+    version: "fhfh.blsh.request-context-result.v1", state: "CAPTURED_READ_ONLY_UNQUALIFIED", executionMode: REQUEST_CONTEXT_CAPTURE,
+    captureContext: REQUEST_CONTEXT_CAPTURE, atomicDatabaseSnapshot: true, sessionClosed: true, ...identity,
+    requestDeployment: { deploymentId, gitCommitSha }, dateFrom, eventThroughDate: sourceDate,
+    snapshotUTC: context.snapshotUTC, statementUTC: context.statementUTC, nativeRetrievedAtUTC, asOfUTC, rows: projected.rows,
+    artifacts: Object.fromEntries(records.slice(0, 6).map(r => [r.file, r.sha256])), independentlyAccepted: false, advancedAdmission: false, score: null,
+  }), "context_result_mismatch");
+  return { request: projected.request, files: files as ReadonlyMap<string, Buffer>, runBytes, objectRowsBytes, receipt: {
+    sourceDate, nativeRunId, nativeManifestSHA256, runId, manifestSHA256, deploymentId, gitCommitSha,
+    dateFrom, eventThroughDate: sourceDate, snapshotUTC: context.snapshotUTC, statementUTC: context.statementUTC,
+    status: "request_context_readback_pending_review" as const, state: COMPLETE, asOfUTC, claimedAtUTC, closedAtUTC, nativeRetrievedAtUTC,
+    independentlyAccepted: false as const, advancedAdmission: false as const, score: null,
+  } };
+}
diff --git a/web/scripts/blsh/retainedArmCReplay.ts b/web/scripts/blsh/retainedArmCReplay.ts
new file mode 100644
index 0000000000000000000000000000000000000000..553748b6ec980e46a0c5ea5e5c778f8dd43a299c
--- /dev/null
+++ b/web/scripts/blsh/retainedArmCReplay.ts
@@ -0,0 +1,177 @@
+/** October 28 single-target replay of the paired November 4 no-overlay research smoke.
+ * From web/: NODE_PATH=. ./node_modules/.bin/ts-node --transpile-only --compiler-options
+ * '{"module":"commonjs","moduleResolution":"node"}' scripts/blsh/retainedArmCReplay.ts [--private | --private-reference]
+ * --private-reference also emits the unaccepted raw arm-C reference packet and compares its exact single-player replay.
+ * --private saves ordered source membership in a new owner-only directory outside the repository.
+ */
+import { strict as assert } from "node:assert";
+import { createHash } from "node:crypto";
+import { mkdirSync, mkdtempSync, readFileSync, writeFileSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+import { qualifyCurrentResearchInputs, type CurrentInputRequest } from "../../lib/buyLowSellHigh/currentInput";
+import { createCurrentProcessEvidenceGate } from "../../lib/buyLowSellHigh/currentProcessEvidence.server";
+import { assembleProfiles, devSlot, type Arm, type DevRow } from "../../lib/buyLowSellHigh/currentWindows";
+import { toDisplayProfile } from "../../lib/buyLowSellHigh/displayProfile";
+import { summarizeHistory } from "../../lib/buyLowSellHigh/productionReference";
+import type { TrainingBlock } from "../../lib/buyLowSellHigh/supportGap";
+
+import { ARM_C_REFERENCE_VERSION, assembleArmCReferenceInputs, selectArmCCurrentPrefix, type ArmCReferencePacket } from "../../lib/buyLowSellHigh/armCCandidate.server";
+
+const documents = join(homedir(), "Documents");
+const current = "Codex/2026-10-27/task-3/current-refresh-20261029-01";
+const baseline = "Claude/2026-11-04/blsh-baseline";
+const sources = {
+  request: [current + "/CURRENT-REQUEST.json", "dcba14c2253d82bc70690d3c21112d926c1cdfc4f361024aa8a02f117e262465"],
+  development: [current + "/dev-history-cache/dev-history.jsonl", "da32a473923e7b9940032c7ee22c1292e73798c7dc242a956a0244233d020106"],
+  history2024: [baseline + "/history-20242025/db-history.jsonl", "3b4e6429d04caa97e63bc37e3ff570b84cd0cd19a00b6248e28d5440b5f5fb3a"],
+  training: ["Codex/2026-10-25/task-2/support-conditioned-ranking-v1/run-guarded-v1/ORIGINAL-BLOCK-CATALOG.jsonl", "f60056cd5ab6b80688d130661d2efbaacfe31c001de7b690a634514900ded529"],
+  smoke: [baseline + "/arm-c-smoke.json", "066833aba6fdbaac1c53eca1b66dba6279efea7400c459eef7cc196aef5e0a91"],
+} as const;
+const digest = (value: string | Uint8Array) => createHash("sha256").update(value).digest("hex");
+function read(source: keyof typeof sources) {
+  const [path, pin] = sources[source], bytes = readFileSync(join(documents, path));
+  assert.equal(digest(new Uint8Array(bytes.buffer, bytes.byteOffset, bytes.byteLength)), pin, source + " SHA256 mismatch");
+  return bytes.toString("utf8");
+}
+
+// Preserve source insertion order for floating-point prior fitting. Select each donor's
+// true final 50 before checking position and measurements, just as the assembler does.
+function historyForTarget(target: number, cutoff: string, trainingIds: Set<number>) {
+  const groups = new Map<number, DevRow[]>();
+  const covered = new Set<number>();
+  for (const source of ["development", "history2024"] as const) {
+    for (const line of read(source).split("\n")) {
+      if (!line) continue;
+      const row: DevRow = JSON.parse(line);
+      covered.add(row.season_id);
+      if (!groups.has(row.player_id)) groups.set(row.player_id, []);
+      groups.get(row.player_id)!.push(row);
+    }
+  }
+  assert.deepEqual([...covered].sort(), [20222023, 20232024, 20242025]);
+  const trainingRows: DevRow[] = [];
+  const history: DevRow[] = [], donors: { playerId: number; sourceIds: number[] }[] = [];
+  for (const [id, rows] of groups) {
+    if (trainingIds.size) trainingRows.push(...rows.filter(r => trainingIds.has(r.id)));
+    if (id === target) {
+      history.push(...rows.filter(r => r.date < cutoff && r.season_id >= 20232024));
+      continue;
+    }
+    const last = rows.sort((a, b) => a.date.localeCompare(b.date) || a.id - b.id).slice(-50);
+    if (last.length !== 50 || !last.every(r => r.position_code === "D" && r.games_played === 1)) continue;
+    const slots = last.map(devSlot);
+    const [qualified] = summarizeHistory(id, "D", slots.map(s => s.tracks.map(v => v ?? NaN)),
+      slots.map(s => s.seconds ?? NaN), slots.map(s => s.id), slots.map(s => s.date), "2026-07-01", true);
+    if (!qualified) continue;
+    history.push(...last);
+    donors.push({ playerId: id, sourceIds: qualified.source_ids });
+  }
+  return { history, trainingRows, donors, covered: [...covered].sort() };
+}
+
+async function replay(privateDetail: boolean, emitReference: boolean) {
+  const example = JSON.parse(read("smoke")).C_weighted_personal_baseline.example;
+  const target: number = example.playerId, cutoff: string = example.reference.baseline.before;
+  const originalRequest = read("request");
+  const request: CurrentInputRequest = JSON.parse(originalRequest);
+  assert(request.wgo && request.individual && request.onIce && request.calendar);
+  request.wgo.rows = request.wgo.rows.filter(r => r.player_id === target);
+  assert(request.wgo.rows.length > 0 && request.wgo.rows.every(r => r.player_name === "Brent Burns" && r.position_code === "D"));
+  const games = new Set(request.wgo.rows.map(r => r.game_id));
+  request.calendar.rows = request.calendar.rows.filter(r => games.has(r.id));
+  request.individual.rows = request.individual.rows.filter(r => r.player_id === target);
+  request.onIce.rows = request.onIce.rows.filter(r => r.player_id === target);
+  const projected = JSON.stringify(request), currentInput = qualifyCurrentResearchInputs(request, null);
+  const gated = createCurrentProcessEvidenceGate()(new TextEncoder().encode(projected), "2026-11-18T00:00:00Z");
+  assert.equal(gated.capturedWindows.length, 1);
+  assert.equal(gated.capturedWindows[0].currentUseQualified, false);
+  assert.equal(gated.score, null);
+  const blocks: TrainingBlock[] = read("training").split("\n").filter(Boolean).map(line => JSON.parse(line) as TrainingBlock)
+    .filter(b => b.player_id !== target && b.position === "D" && b.qualified_process_exposure && b.dates.at(-1)! < cutoff);
+
+  const trainingIds = new Set<number>(emitReference ? blocks.flatMap(b => b.source_ids) : []);
+  const { history, trainingRows, donors, covered } = historyForTarget(target, cutoff, trainingIds);
+
+  const run = async (arm: Arm) => {
+    const profiles = await assembleProfiles({ arm, current: currentInput.records, history, blocks, coveredSeasons: covered,
+      eventThroughDate: request.eventThroughDate, names: new Map([[target, "Brent Burns"]]) });
+    assert.equal(profiles.length, 1);
+    const profile = profiles[0];
+    assert.equal(profile.playerId, target);
+    assert.equal(profile.window.dates[0], cutoff);
+    const mapped = toDisplayProfile(profile, null, request.eventThroughDate, "single_player");
+    assert.equal(mapped.score.value, profile.result.value);
+    return { profile, mapped };
+  };
+  const a = await run("A_development_reference"), c = await run("C_weighted_personal_baseline");
+  assert.equal(a.profile.result.value, example.aValue, "paired historic A index");
+  assert.equal(c.profile.result.value, example.value, "historic C index");
+  assert.deepEqual(c.profile.comparisons, example.comparisons);
+  const reference = c.profile.reference;
+  assert.equal(reference.personalN, example.reference.personalN);
+  assert.equal(reference.sourceIds.length, example.reference.sourceIds);
+  assert.equal(new Set(reference.sourceIds).size, reference.sourceIds.length);
+  assert.deepEqual([reference.dates[0], reference.dates.at(-1)], example.reference.dates);
+  assert.deepEqual(reference.missingSeasons, example.reference.missingSeasons);
+  assert.deepEqual(c.profile.window.sourceIds, a.profile.window.sourceIds);
+  const pairs = (ids: number[], dates: string[]) => {
+    assert.equal(ids.length, dates.length);
+    return ids.map((sourceId, i) => ({ sourceId, date: dates[i] }));
+  };
+  const membership = { current: pairs(c.profile.window.sourceIds, c.profile.window.dates),
+    armC: pairs(reference.sourceIds, reference.dates), armA: pairs(a.profile.reference.sourceIds, a.profile.reference.dates) };
+  const membershipSHA256 = digest(JSON.stringify(membership.armC));
+  // Cross-checked independently against the three input files in date/source-ID order.
+  assert.equal(membershipSHA256, "a03d465844416530e9c40835904a99489f81798e1a777476a12856acd771c460", "dated reference membership changed");
+  let privatePath: string | null = null;
+  let referenceReceipt = null;
+  if (privateDetail || emitReference) {
+    const parent = join(documents, "Codex/2026-11-18/blsh-retained-window-replays");
+    mkdirSync(parent, { recursive: true, mode: 0o700 });
+    const directory = mkdtempSync(join(parent, "arm-c-"));
+    privatePath = join(directory, "membership.json");
+    writeFileSync(privatePath, JSON.stringify({ playerId: target, sources, membershipSHA256, membership, donors,
+      trainingBlockSourceIds: blocks.map(b => b.source_ids) }, null, 2) + "\n", { flag: "wx", mode: 0o600 });
+    if (emitReference) {
+      const originalRows = new Map([...history, ...trainingRows].map(r => [r.id, r]));
+      const packet: ArmCReferencePacket = { version: ARM_C_REFERENCE_VERSION, arm: "C_weighted_personal_baseline",
+        policyId: "fhfh.blsh.arm-c.local-reference-proposal.v1", playerId: target, seasonId: request.seasonId, before: cutoff,
+        coveredSeasons: covered, history: [...originalRows.values()], personalSourceIds: history.filter(r => r.player_id === target).map(r => r.id),
+        productionDonors: donors, trainingBlocks: blocks, preWindowCurrentRequestSHA256: sources.request[1] };
+      const bytes = new TextEncoder().encode(JSON.stringify(packet));
+      assert(bytes.length <= 64 * 1024 * 1024);
+      const saved = JSON.parse(new TextDecoder().decode(bytes)) as ArmCReferencePacket;
+      const lastFive = currentInput.records.slice(-5);
+      const prefix = selectArmCCurrentPrefix(saved.preWindowCurrentRequestSHA256, new Map([[sources.request[1], new TextEncoder().encode(originalRequest)]]),
+        { playerId: target, seasonId: request.seasonId, before: cutoff, eventThroughDate: request.eventThroughDate, asOfUTC: request.asOfUTC });
+      assert.deepEqual(prefix.records.map(r => r.raw.record.id), currentInput.records.slice(0, -5).map(r => r.raw.record.id));
+      const roles = assembleArmCReferenceInputs(saved, new Set(currentInput.records.map(r => r.raw.record.id)), "D");
+      const [rebuilt] = await assembleProfiles({ ...roles, arm: saved.arm, current: [...prefix.records, ...lastFive], coveredSeasons: saved.coveredSeasons,
+        eventThroughDate: request.eventThroughDate, names: new Map([[target, "Brent Burns"]]) });
+      assert.deepEqual(rebuilt, c.profile);
+      const path = join(directory, "unaccepted-reference.json");
+      writeFileSync(path, bytes, { flag: "wx", mode: 0o600 });
+      referenceReceipt = { path, bytes: bytes.length, sha256: digest(bytes), rawRows: saved.history.length, historicalPersonalRows: saved.personalSourceIds.length,
+        prefixRows: prefix.records.length, originalCurrentRequestRows: prefix.capture!.capturedWgoRows, originalCurrentRequestSHA256: sources.request[1],
+        sameHistoricalProfile: true, accepted: false };
+    }
+  }
+  return { inputs: Object.fromEntries(Object.entries(sources).map(([key, [, pin]]) => [key, pin])),
+    projectionSHA256: digest(projected), sourceAsOfUTC: request.asOfUTC, recordedThrough: request.eventThroughDate,
+    targetCount: 1, currentAppearances: currentInput.records.length, windowDates: c.profile.window.dates,
+    cohort: { position: "D", productionDonors: donors.length, productionDonorGames: donors.length * 50,
+      trainingBlocksPresented: blocks.length, fittedSupportDonors: c.profile.result.donorPlayers },
+    armA: { noOverlayIndex: a.mapped.score.value, referenceCount: a.profile.reference.sourceIds.length },
+    armC: { noOverlayIndex: c.mapped.score.value, referenceCount: reference.sourceIds.length, firstReference: reference.dates[0],
+      lastReference: reference.dates.at(-1), membershipSHA256, missingSeasons: reference.missingSeasons,
+      comparisons: c.profile.comparisons, historicalResearchList: c.profile.result.researchList, mappedList: c.mapped.score.list, mappedHeadline: c.mapped.score.headline },
+    closedPolicy: { evaluatedAtUTC: gated.asOfUTC, currentUseQualified: gated.capturedWindows[0].currentUseQualified, score: gated.score },
+    leagueRank: null, privatePath, referenceReceipt };
+}
+
+if (require.main === module) {
+  assert(process.argv.length === 2 || process.argv.length === 3 && ["--private", "--private-reference"].includes(process.argv[2]), "usage: retainedArmCReplay.ts [--private | --private-reference]");
+  void replay(process.argv[2] === "--private", process.argv[2] === "--private-reference").then(result => process.stdout.write(JSON.stringify(result, null, 2) + "\n"))
+    .catch(error => { console.error(error); process.exitCode = 1; });
+}
diff --git a/web/scripts/blsh/retainedWindowReplay.ts b/web/scripts/blsh/retainedWindowReplay.ts

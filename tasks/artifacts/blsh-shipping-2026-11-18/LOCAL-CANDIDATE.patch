+  if (file === "MANIFEST.json") f.run.manifest_sha256 = row.sha256;
+  else replace(f, "MANIFEST.json", text => {
+    const manifest = JSON.parse(text);
+    manifest.files[index] = { file, bytes: row.bytes, sha256: row.sha256 };

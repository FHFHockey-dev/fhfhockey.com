+  const fractionalMicros = (expected.ledgerClosedAtUTC.match(/\.(\d{1,6})/)?.[1] ?? "").padEnd(6, "0").slice(3);
+  need(t0 * 1000 >= Date.parse(expected.ledgerClosedAtUTC) * 1000 + Number(fractionalMicros), "official_acquisition_precedes_close");

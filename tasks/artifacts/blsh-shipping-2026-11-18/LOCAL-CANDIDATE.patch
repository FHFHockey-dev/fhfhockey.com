+        while (cert?.raw && !seen.has(cert.fingerprint256)) {
+          need(chainDER.length < 10, "official_certificate_chain_length");
+          seen.add(cert.fingerprint256); chainDER.push(cert.raw.toString("base64")); cert = cert.issuerCertificate;
+        }

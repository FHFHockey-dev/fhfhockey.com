+const normalize = (value: string) => value.normalize("NFKD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/[^\p{L}\p{N}]+/gu, " ").trim();
+const indexed = PLAYER_CATALOG.map(player => ({ player, name: normalize(player.name), text: normalize(`${player.name} ${player.team} ${player.id}`) }));
+
+/** Bounded local lookup: every token must match, duplicates remain separate stable IDs, nothing is auto-selected. */
+export function searchPlayerCatalog(query: string): { matches: PlayerCatalogEntry[]; total: number } {
+  const needle = normalize(query.slice(0, 100));
+  if (needle.length < 2) return { matches: [], total: 0 };
+  const tokens = needle.split(" ");
+  const found = indexed.filter(row => tokens.every(token => row.text.includes(token)));
+  found.sort((a, b) => Number(b.name === needle) - Number(a.name === needle) || a.name.localeCompare(b.name, "en") || a.player.id - b.player.id);
+  return { matches: found.slice(0, PLAYER_LOOKUP_LIMIT).map(row => row.player), total: found.length };
+}

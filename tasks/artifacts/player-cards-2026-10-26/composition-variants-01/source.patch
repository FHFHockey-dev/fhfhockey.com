+export async function prepareTeamLogo(team: string, signal?: AbortSignal): Promise<PreparedTeamLogo> {
+  const source = LOGOS[team];
+  if (!source || !teamsInfo[team]) throw new Error("A reviewed local team logo is unavailable.");

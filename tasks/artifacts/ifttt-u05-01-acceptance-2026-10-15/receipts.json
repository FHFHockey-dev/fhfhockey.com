      "query": "BEGIN READ ONLY;\nSET LOCAL statement_timeout = '5s';\nWITH sampled AS MATERIALIZED (\n  SELECT id, source, source_group, source_key, source_account, username,\n         tweet_id, received_at, tweet_created_at, processing_status, link_to_tweet\n  FROM public.line_source_ifttt_events\n  WHERE received_at >= '2026-10-01T00:00:00Z' AND received_at < '2026-10-15T05:25:00Z'\n  ORDER BY received_at DESC LIMIT 5000\n), groups AS (\n  SELECT source, source_group, source_key, source_account, username,\n    count(*) AS event_count, min(received_at) AS first_received_at, max(received_at) AS last_received_at,\n    array_agg(DISTINCT processing_status ORDER BY processing_status) AS processing_statuses\n  FROM sampled GROUP BY source, source_group, source_key, source_account, username\n), matches AS (\n  SELECT id,source,source_group,source_key,source_account,username,tweet_id,received_at,tweet_created_at,processing_status\n  FROM sampled\n  WHERE lower(replace(source_account,'@','')) IN ('dfofantasy','nhl_rosters')\n     OR lower(replace(coalesce(username,''),'@','')) IN ('dfofantasy','nhl_rosters')\n     OR lower(coalesce(link_to_tweet,'')) ~ '^https?://(www\\.)?(twitter\\.com|x\\.com)/(dfofantasy|nhl_rosters)/status(es)?/'\n  ORDER BY received_at DESC LIMIT 20\n)\nSELECT now() AS observed_at,\n  (SELECT count(*) FROM sampled) AS sample_count,\n  (SELECT min(received_at) FROM sampled) AS sample_first_received_at,\n  (SELECT max(received_at) FROM sampled) AS sample_last_received_at,\n  coalesce((SELECT jsonb_agg(to_jsonb(groups) ORDER BY event_count DESC) FROM groups),'[]'::jsonb) AS source_groups,\n  coalesce((SELECT jsonb_agg(to_jsonb(matches)) FROM matches),'[]'::jsonb) AS requested_source_matches;\nCOMMIT;",

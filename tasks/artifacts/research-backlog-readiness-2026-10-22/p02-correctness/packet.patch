+      classifiedStarts += 1;
+      qualityStarts += classification;
+    }
+  }
+  return {
+    starts,
+    classifiedStarts,
+    unknownStarts,
+    rate: unknownStarts === 0 && starts > 0 && classifiedStarts === starts
+      ? qualityStarts / starts
+      : null
+  };

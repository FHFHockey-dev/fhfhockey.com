+      : completePage(start));
+    render(<GoalieShareChart />);
+    await finishRequests();
+    expect(screen.queryAllByTestId("chart")).toHaveLength(0);
+    expect(screen.getByRole("alert").textContent).toMatch(/unavailable|incomplete/i);
+  });
+
+  it.each([
+    { data: rows.slice(0, 100) },
+    { total: 250, data: null },

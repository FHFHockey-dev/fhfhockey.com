+  it("keeps every card label at a phone-legible minimum and the default notice beside the sample line", () => {
+    const { container } = render(<EditorialPlayerCard snapshot={fixture()} />);
+    const sizes = [...container.querySelectorAll("text")].map(node => Number(node.getAttribute("font-size") ?? node.closest("[font-size]")!.getAttribute("font-size")));
+    expect(Math.min(...sizes)).toBeGreaterThanOrEqual(17);
+    expect(container.querySelector("[data-footer-layout]")!.getAttribute("data-footer-layout")).toBe("inline-notice");
+    const svg = container.querySelector("svg")!;
+    expect(svg.textContent).toContain("Regular season · own spans may differ");
+    expect(svg.textContent).toContain("fhfhockey.com");
+    expect(svg.textContent).toContain("midrank percentile · Numeric magnitude ≠ quality");
+  });
+  it("moves a long warning notice onto its own footer line instead of colliding with the sample line", () => {
+    const { container } = render(<EditorialPlayerCard snapshot={fixture({ playerId: 1004, fullN: true })} />);
+    const footer = container.querySelector("[data-footer-layout]")!;
+    expect(footer.getAttribute("data-footer-layout")).toBe("stacked-notice");
+    const [sampleLine, notice] = [...footer.querySelectorAll("text")];
+    expect(notice.textContent).toBe("Known short season · proposed policy · Some metrics undefined");
+    expect(notice.getAttribute("x")).toBe("40");
+    expect(Number(notice.getAttribute("y"))).toBeGreaterThan(Number(sampleLine.getAttribute("y")));
+  });
+  it("splits unavailable ratio labels into two readable lines", () => {
+    const { container } = render(<EditorialPlayerCard snapshot={fixture({}, "unknown-pool")} />);
+    const label = container.querySelector('[data-metric-id="ipp"] [data-unavailable]')!;
+    expect([...label.querySelectorAll("tspan")].map(node => node.textContent)).toEqual(["Rank unavailable", "incomplete pool"]);
+    expect(Number(label.getAttribute("font-size"))).toBeGreaterThanOrEqual(19);
+  });

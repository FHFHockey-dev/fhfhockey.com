+    expect(refreshTeamMock).toHaveBeenCalledWith(
+      expect.objectContaining({ gameIds: [STALE_GAME] }),
+    );
+    expect(res.body).toMatchObject({
+      success: true,
+      normalizedGameIds: [STALE_GAME],
+      refreshedGameIds: [STALE_GAME],

+  or coalesce(report->>'originalUrl','') !~* ('^https://(x[.]com|twitter[.]com)/'||ltrim(coalesce(original->>'quoted_author_handle',original->>'source_handle'),'@')||'/status/'||(report->'provenance'->>'originalTweetId')||'$')
